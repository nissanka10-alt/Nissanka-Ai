---
import Logo from "./Logo.astro";

const advisoryLinks = [
    { label: "AI Opportunity & Readiness Review", mobileLabel: "AI Review", href: "/ai-review/" },
    { label: "AI Strategy & Transformation", mobileLabel: "AI Strategy", href: "/advisory/ai-strategy/" },
    { label: "Workforce Intelligence", href: "/advisory/workforce-intelligence/" },
    { label: "Leadership Readiness", href: "/advisory/leadership-readiness/" },
];

const ideasLinks = [
    { label: "Insights", href: "/insights/", enabled: true },
    { label: "The Work AI Cannot Do", href: "/ideas/", enabled: true },
    { label: "Tools & Frameworks", href: "/tools/", enabled: false },
].filter((item) => item.enabled);
---

<header class="site-header">
    <div class="shell site-header__inner">
        <Logo />
        <nav aria-label="Primary navigation">
            <details class="nav-group">
                <summary>Advisory</summary>
                <ul>
                    {advisoryLinks.map((item) => (
                        <li><a href={item.href}><span class:list={{ "desktop-label": item.mobileLabel }}>{item.label}</span>{item.mobileLabel && <span class="mobile-label">{item.mobileLabel}</span>}</a></li>
                    ))}
                </ul>
            </details>
            <details class="nav-group">
                <summary>Ideas</summary>
                <ul>
                    {ideasLinks.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
                </ul>
            </details>
            <a href="/speaking/">Speaking</a>
            <a href="/about/">About</a>
            <a class="site-header__cta" href="/ai-review/">Start with an AI Review</a>
        </nav>
    </div>
</header>

<style>
    .site-header {
        border-bottom: var(--border-architectural);
        background: var(--colour-white);
    }

    .site-header__inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        min-height: 6rem;
    }

    nav {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 1.35rem;
        font-size: 0.875rem;
        font-weight: 600;
    }

    nav a {
        text-decoration: none;
    }

    nav a:hover,
    .nav-group summary:hover {
        text-decoration: underline;
        text-underline-offset: 0.35em;
    }

    .nav-group {
        position: relative;
    }

    .nav-group summary {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        cursor: pointer;
        list-style: none;
    }

    .nav-group summary::-webkit-details-marker {
        display: none;
    }

    .nav-group summary::after {
        content: "+";
        font-family: var(--font-mono);
        font-size: 0.75rem;
        font-weight: 400;
    }

    .nav-group[open] summary::after {
        content: "−";
    }

    .nav-group summary:focus-visible {
        outline: 2px solid currentColor;
        outline-offset: 0.35rem;
    }

    .nav-group ul {
        position: absolute;
        z-index: 10;
        top: calc(100% + 1rem);
        left: -1rem;
        width: max-content;
        min-width: 17rem;
        margin: 0;
        padding: 0.5rem 1rem;
        border: var(--border-architectural);
        background: var(--colour-white);
        list-style: none;
    }

    .nav-group li + li {
        border-top: var(--border-architectural);
    }

    .nav-group li a {
        display: block;
        padding-block: 0.8rem;
    }

    .mobile-label {
        display: none;
    }

    .site-header__cta {
        padding: 0.75rem 1rem;
        border: 1px solid var(--colour-black);
        background: var(--colour-black);
        color: var(--colour-white);
    }

    .site-header__cta:hover {
        background: var(--colour-white);
        color: var(--colour-black);
        text-decoration: none;
    }

    @media (max-width: 68rem) {
        .site-header__inner {
            align-items: flex-start;
            flex-direction: column;
            padding-block: 1rem;
        }

        nav {
            justify-content: flex-start;
            flex-wrap: wrap;
            gap: 0.75rem 1rem;
            width: 100%;
        }

        .nav-group ul {
            position: static;
            width: auto;
            min-width: 0;
            margin-top: 0.75rem;
        }

        .desktop-label {
            display: none;
        }

        .mobile-label {
            display: inline;
        }
    }

    @media (max-width: 36rem) {
        .site-header__inner {
            gap: 1rem;
        }

        nav {
            display: grid;
            width: 100%;
            grid-template-columns: minmax(0, 1fr);
            gap: 0;
            border-top: var(--border-architectural);
        }

        nav > a,
        .nav-group summary {
            padding-block: 0.7rem;
            border-bottom: var(--border-architectural);
        }

        .nav-group ul {
            margin-top: 0;
            border-top: 0;
            border-right: 0;
            border-left: 0;
            padding-inline: 1rem;
        }

        .site-header__cta {
            margin-top: 0.75rem;
            text-align: center;
        }
    }
</style>
