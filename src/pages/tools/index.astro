---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { toolGeographies, toolResources } from "../../data/tools";

const title = "Tools & Frameworks | Nissanka Advisory";
const description = "Practical frameworks, templates and assessment tools for AI adoption, workforce intelligence, governance and organisational change.";
const resourceTypes = [
    { label: "Frameworks & Templates", copy: "Practical resources that can be downloaded, adapted and used internally." },
    { label: "Assessments", copy: "Structured ways to understand readiness, risk or organisational capability." },
    { label: "Interactive Tools", copy: "Guided tools that allow users to enter information and generate a useful output." },
];
const structuredData = {
    "@context": "https://schema.org",
    "@graph": [
        { "@type": "CollectionPage", "@id": "https://nissanka.co.uk/tools/#webpage", url: "https://nissanka.co.uk/tools/", name: title, description },
        { "@type": "BreadcrumbList", itemListElement: [
            { "@type": "ListItem", position: 1, name: "Home", item: "https://nissanka.co.uk/" },
            { "@type": "ListItem", position: 2, name: "Tools", item: "https://nissanka.co.uk/tools/" },
        ] },
    ],
};
---

<BaseLayout {title} {description} path="/tools/" {structuredData}>
    <section class="tools-hero" aria-labelledby="tools-title"><div class="shell"><Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Tools" }]} /><p class="system-label">Tools</p><div class="hero-grid"><h1 id="tools-title">Useful thinking should be usable.</h1><p>Practical frameworks, templates and assessment tools designed to help leaders turn ideas into better decisions.</p></div></div></section>

    <section class="tools-intro" aria-labelledby="tools-intro-title"><div class="shell intro-grid"><div><p class="system-label">From insight to action</p><h2 id="tools-intro-title">From insight to action.</h2></div><div class="intro-copy"><p>Some resources will be simple templates. Others will help leaders assess readiness, explore risk or work through a decision.</p><p class="editorial-statement">The purpose is the same: make complex organisational questions easier to work with.</p></div></div></section>

    <section class="resource-types" aria-labelledby="resource-types-title"><div class="shell"><p class="system-label">Resource types</p><h2 id="resource-types-title">Different formats for different decisions.</h2><ol>{resourceTypes.map((item, index) => <li><p class="number">{String(index + 1).padStart(2, "0")}</p><div><h3>{item.label}</h3><p>{item.copy}</p></div></li>)}</ol></div></section>

    <section class="geography" aria-labelledby="geography-title"><div class="shell geography-grid"><div><p class="system-label">Geography</p><h2 id="geography-title">Context should always be visible.</h2></div><div><ul aria-label="Supported resource geographies">{toolGeographies.map((geography) => <li>{geography}</li>)}</ul><p>Some resources are universal. Others depend on local regulation or market context. Each published resource will state its geography clearly.</p></div></div></section>

    <section class="tools-empty" aria-labelledby="resources-title"><div class="shell"><p class="system-label">Published resources</p><h2 id="resources-title">Resources will be published here as they are released.</h2>{toolResources.length === 0 && <p>The library will contain only approved, usable resources. It will never contain placeholders.</p>}<div class="connections"><p><span>Related thinking</span><a href="/insights/">Explore Insights <span aria-hidden="true">→</span></a></p><p><span>Practical support</span><a href="/advisory/">Explore Advisory <span aria-hidden="true">→</span></a></p></div></div></section>
</BaseLayout>

<style>
    .tools-hero,.tools-intro,.resource-types,.geography,.tools-empty{padding-block:clamp(5rem,9vw,8rem);border-bottom:var(--border-architectural)}.tools-hero{padding-top:2rem;background:var(--colour-paper)}.tools-hero :global(.breadcrumbs){margin-bottom:clamp(4rem,8vw,7rem)}.hero-grid,.intro-grid,.geography-grid{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:var(--grid-gap);align-items:end;margin-top:1.5rem}.hero-grid h1{grid-column:1/span 7;max-width:11ch;margin:0;font-family:var(--font-display);font-feature-settings:"kern" 1;font-kerning:normal;font-size:clamp(3.75rem,6vw,5.5rem);letter-spacing:normal;line-height:.96}.hero-grid>p{grid-column:9/-1;margin:0;font-size:1.125rem}.intro-grid>div:first-child,.geography-grid>div:first-child{grid-column:1/span 5;align-self:start}.intro-copy,.geography-grid>div:last-child{grid-column:7/-1}.tools-intro h2,.resource-types h2,.geography h2{max-width:13ch;margin:1.5rem 0 0;font-size:clamp(2.5rem,4vw,3.5rem);letter-spacing:-.04em}.intro-copy>p:first-child{max-width:37rem;margin:0;font-size:1.125rem}.editorial-statement{max-width:18ch;margin:3rem 0 0;font-family:var(--font-display);font-feature-settings:"kern" 1;font-kerning:normal;font-size:clamp(2.25rem,4vw,3.75rem);font-weight:900;letter-spacing:normal;line-height:1}.resource-types h2{margin-bottom:clamp(3rem,7vw,6rem)}.resource-types ol{margin:0;padding:0;list-style:none}.resource-types li{display:grid;grid-template-columns:minmax(4rem,2fr) minmax(0,10fr);gap:var(--grid-gap);padding-block:clamp(2rem,4vw,3.5rem);border-top:var(--border-architectural)}.resource-types .number{margin:0;font-family:var(--font-mono);font-size:.75rem}.resource-types h3{margin:0 0 1rem;font-size:clamp(1.75rem,3vw,2.5rem)}.resource-types li div p{max-width:43rem;margin:0}.geography{background:var(--colour-obsidian);color:white}.geography-grid{align-items:start}.geography ul{display:flex;flex-wrap:wrap;gap:1rem 2rem;margin:0 0 2.5rem;padding:0 0 1.25rem;border-bottom:1px solid #555;list-style:none;font-family:var(--font-mono);font-size:.75rem;text-transform:uppercase}.geography-grid>div:last-child>p{max-width:37rem;margin:0}.tools-empty{border-bottom:0}.tools-empty .shell{max-width:67rem}.tools-empty h2{max-width:19ch;margin:2rem 0 1.5rem;font-family:var(--font-display);font-feature-settings:"kern" 1;font-kerning:normal;font-size:clamp(2.75rem,5vw,4.75rem);letter-spacing:normal;line-height:1}.tools-empty>div>p{max-width:40rem}.connections{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--grid-gap);margin-top:clamp(4rem,8vw,7rem)}.connections p{display:flex;flex-direction:column;gap:1rem;margin:0;padding-top:1.25rem;border-top:var(--border-architectural)}.connections span:first-child{font-family:var(--font-mono);font-size:.7rem;text-transform:uppercase}.connections a{font-weight:700;text-underline-offset:.35em}
    @media(max-width:52rem){.hero-grid,.intro-grid,.geography-grid{grid-template-columns:1fr}.hero-grid h1,.hero-grid>p,.intro-grid>div:first-child,.intro-copy,.geography-grid>div:first-child,.geography-grid>div:last-child{grid-column:1}.hero-grid>p,.intro-copy,.geography-grid>div:last-child{margin-top:3rem}}
    @media(max-width:32rem){.resource-types li,.connections{grid-template-columns:1fr}.connections{gap:2rem}.geography ul{gap:.75rem 1.25rem}}
</style>
