---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { jkhEvent } from "../../../config/jkh.js";

const title = "Please Try Again | Nissanka Advisory";
const description = "The session resource request could not be saved.";
---

<BaseLayout {title} {description} path={jkhEvent.errorPath} robots="noindex, nofollow">
    <section class="recovery" aria-labelledby="recovery-title">
        <div class="shell recovery-shell">
            <p class="system-label">Session resource</p>
            <h1 id="recovery-title">We couldn’t save your details just now.</h1>
            <p>Please try again.</p>
            <div class="recovery-links">
                <a href={jkhEvent.landingPath}>Try again <span aria-hidden="true">→</span></a>
                <a href="mailto:gishan@nissanka.co.uk">gishan@nissanka.co.uk</a>
            </div>
        </div>
    </section>
</BaseLayout>

<style>
    .recovery {
        padding-block: clamp(4rem, 10vw, 9rem);
        background: var(--colour-paper);
    }

    .recovery-shell {
        max-width: 66rem;
    }

    h1 {
        max-width: 13ch;
        margin: clamp(2.75rem, 7vw, 6rem) 0 1.5rem;
        font-family: var(--font-display);
        font-size: clamp(3.5rem, 7vw, 6.75rem);
        font-weight: 900;
        font-kerning: normal;
        font-feature-settings: "kern" 1;
        letter-spacing: normal;
        line-height: 0.97;
    }

    .recovery p {
        font-size: 1.15rem;
    }

    .recovery-links {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem 2.5rem;
        margin-top: 3rem;
        padding-top: 1.5rem;
        border-top: var(--border-architectural);
    }

    .recovery-links a {
        color: inherit;
        text-underline-offset: 0.3em;
    }

    @media (max-width: 40rem) {
        h1 {
            font-size: clamp(3rem, 14vw, 4.25rem);
            overflow-wrap: normal;
            word-break: normal;
            hyphens: none;
        }

        .recovery-links {
            display: grid;
        }
    }
</style>
