---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { jkhEvent } from "../../config/jkh.js";

const title = "JKH Executive Session | Nissanka Advisory";
const description = "Download the slides from the John Keells Holdings executive session in Colombo on 20 October 2026.";
---

<BaseLayout {title} {description} path={jkhEvent.landingPath} robots="noindex, nofollow">
    <section class="jkh-landing" aria-labelledby="jkh-title">
        <div class="shell jkh-grid">
            <div class="session-context">
                <p class="system-label">John Keells Holdings / Executive Session / Colombo</p>
                <h1 id="jkh-title">Take the thinking with you.</h1>
                <p class="session-intro">Download the slides from today’s executive session and keep the key ideas, questions and practical actions to revisit with your organisation.</p>
                <dl class="session-meta">
                    <div>
                        <dt>Date</dt>
                        <dd>20 October 2026</dd>
                    </div>
                    <div>
                        <dt>Location</dt>
                        <dd>Colombo</dd>
                    </div>
                </dl>
            </div>

            <div class="form-column">
                <div class="form-intro">
                    <p class="system-label">Get the slides</p>
                    <h2>A few details and the deck is yours.</h2>
                </div>

                <p class="form-error" data-form-error hidden role="alert">
                    Please check the required details and try again.
                </p>

                <form action="/api/jkh-lead" method="post" data-jkh-form>
                    <input type="hidden" name="source" value={jkhEvent.defaultSource} data-source />
                    <div class="honeypot" aria-hidden="true">
                        <label for="jkh-website">Leave this field empty</label>
                        <input id="jkh-website" name="_honey" type="text" tabindex="-1" autocomplete="off" />
                    </div>

                    <div class="field-row">
                        <div class="field">
                            <label for="jkh-name">Name <span aria-hidden="true">*</span></label>
                            <input id="jkh-name" name="name" type="text" autocomplete="name" maxlength="120" required />
                        </div>
                        <div class="field">
                            <label for="jkh-email">Work email <span aria-hidden="true">*</span></label>
                            <input id="jkh-email" name="email" type="email" autocomplete="email" maxlength="254" required />
                        </div>
                    </div>

                    <div class="field-row">
                        <div class="field">
                            <label for="jkh-job-title">Position / job title <span aria-hidden="true">*</span></label>
                            <input id="jkh-job-title" name="job_title" type="text" autocomplete="organization-title" maxlength="160" required />
                        </div>
                        <div class="field">
                            <label for="jkh-company">Company / organisation <span aria-hidden="true">*</span></label>
                            <input id="jkh-company" name="company" type="text" autocomplete="organization" maxlength="200" required />
                        </div>
                    </div>

                    <div class="field">
                        <label for="jkh-phone">Mobile / phone number <span class="optional">Optional</span></label>
                        <input id="jkh-phone" name="phone" type="tel" autocomplete="tel" maxlength="50" />
                    </div>

                    <label class="consent" for="jkh-updates">
                        <input id="jkh-updates" name="marketing_opt_in" type="checkbox" value="1" />
                        <span>Keep me updated with occasional practical insights on AI, workforce intelligence and transformation.</span>
                    </label>

                    <button type="submit">Get the slides <span aria-hidden="true">→</span></button>

                    <p class="privacy-copy">
                        We’ll use your details to provide the requested resource and follow up where relevant to this session. Updates are optional.
                        <a href="/privacy/">Privacy &amp; Cookie Policy <span aria-hidden="true">→</span></a>
                    </p>
                </form>
            </div>
        </div>
    </section>

    <script is:inline>
        (() => {
            const form = document.querySelector("[data-jkh-form]");
            if (!form) return;

            const parameters = new URLSearchParams(window.location.search);
            const source = parameters.get("source");
            const sourceField = form.querySelector("[data-source]");
            if (source && sourceField && /^[a-z0-9_-]{1,48}$/i.test(source)) {
                sourceField.value = source.toLowerCase();
            }

            if (parameters.get("error") === "validation") {
                const message = document.querySelector("[data-form-error]");
                if (message) message.hidden = false;
            }
        })();
    </script>
</BaseLayout>

<style>
    .jkh-landing {
        padding-block: clamp(2.25rem, 5vw, 5.5rem) clamp(4rem, 8vw, 7.5rem);
        background: var(--colour-paper);
    }

    .jkh-grid {
        display: grid;
        grid-template-columns: minmax(0, 0.9fr) minmax(27rem, 1fr);
        gap: clamp(4rem, 8vw, 8rem);
        align-items: start;
    }

    .session-context {
        position: sticky;
        top: 7rem;
    }

    .session-context h1 {
        max-width: 8.5ch;
        margin: clamp(2.5rem, 6vw, 6rem) 0 1.75rem;
        font-family: var(--font-display);
        font-size: clamp(4.25rem, 7vw, 7.25rem);
        font-weight: 900;
        font-kerning: normal;
        font-feature-settings: "kern" 1;
        letter-spacing: normal;
        line-height: 0.94;
    }

    .session-intro {
        max-width: 36rem;
        margin: 0;
        font-size: clamp(1.05rem, 1.6vw, 1.3rem);
        line-height: 1.65;
    }

    .session-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 2rem 3.5rem;
        margin: clamp(2.5rem, 5vw, 4.5rem) 0 0;
    }

    .session-meta div {
        min-width: 8rem;
    }

    .session-meta dt,
    .session-meta dd {
        font-family: var(--font-mono);
        font-size: 0.72rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
    }

    .session-meta dt {
        color: var(--colour-silver);
    }

    .session-meta dd {
        margin: 0.45rem 0 0;
    }

    .form-column {
        padding-left: clamp(2rem, 5vw, 5rem);
        border-left: var(--border-architectural);
    }

    .form-intro {
        padding-bottom: 2rem;
        border-bottom: var(--border-architectural);
    }

    .form-intro h2 {
        max-width: 18ch;
        margin: 1.25rem 0 0;
        font-size: clamp(1.8rem, 3vw, 2.75rem);
        line-height: 1.1;
    }

    .form-error {
        margin: 1.5rem 0 0;
        padding: 1rem;
        border: 1px solid currentColor;
        font-weight: 600;
    }

    form {
        display: grid;
        gap: 1.5rem;
        margin-top: 2rem;
    }

    .field-row {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1.25rem;
    }

    .field {
        display: grid;
        gap: 0.65rem;
    }

    .field label,
    .optional {
        font-family: var(--font-mono);
        font-size: 0.72rem;
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }

    .optional {
        margin-left: 0.5rem;
        color: var(--colour-silver);
    }

    input[type="text"],
    input[type="email"],
    input[type="tel"] {
        width: 100%;
        min-height: 3.35rem;
        padding: 0.8rem 0;
        border: 0;
        border-bottom: 1px solid var(--colour-black);
        border-radius: 0;
        background: transparent;
        color: var(--colour-obsidian);
        font: inherit;
    }

    input:focus-visible,
    button:focus-visible,
    a:focus-visible {
        outline: 2px solid currentColor;
        outline-offset: 4px;
    }

    .consent {
        display: grid;
        grid-template-columns: 1.35rem minmax(0, 1fr);
        gap: 0.85rem;
        align-items: start;
        margin-top: 0.4rem;
        font-size: 0.94rem;
        line-height: 1.55;
        cursor: pointer;
    }

    .consent input {
        width: 1.2rem;
        height: 1.2rem;
        margin: 0.12rem 0 0;
        border-radius: 0;
        accent-color: var(--colour-black);
    }

    button {
        justify-self: start;
        min-height: 3.5rem;
        padding: 0.9rem 1.4rem;
        border: 1px solid var(--colour-black);
        border-radius: 0;
        background: var(--colour-black);
        color: var(--colour-white);
        font: 700 0.82rem/1 var(--font-mono);
        letter-spacing: 0.04em;
        text-transform: uppercase;
        cursor: pointer;
    }

    button:hover {
        background: transparent;
        color: var(--colour-black);
    }

    .privacy-copy {
        max-width: 44rem;
        margin: 0;
        color: var(--colour-silver);
        font-size: 0.8rem;
        line-height: 1.6;
    }

    .privacy-copy a {
        display: inline-block;
        margin-top: 0.35rem;
        color: var(--colour-obsidian);
        text-underline-offset: 0.25em;
    }

    .honeypot {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip: rect(0 0 0 0);
        clip-path: inset(50%);
        white-space: nowrap;
    }

    @media (max-width: 64rem) {
        .jkh-grid {
            grid-template-columns: 1fr;
            gap: 3rem;
        }

        .session-context {
            position: static;
        }

        .session-context h1 {
            max-width: 10ch;
            margin-top: clamp(2.5rem, 8vw, 5rem);
        }

        .form-column {
            padding: 3rem 0 0;
            border-top: var(--border-architectural);
            border-left: 0;
        }
    }

    @media (max-width: 40rem) {
        .jkh-landing {
            padding-top: 1.75rem;
        }

        .session-context h1 {
            margin-top: 2.25rem;
            font-size: clamp(3.2rem, 15vw, 4.25rem);
            overflow-wrap: normal;
            word-break: normal;
            hyphens: none;
        }

        .session-intro {
            font-size: 1rem;
        }

        .session-meta {
            margin-top: 2rem;
        }

        .jkh-grid {
            gap: 2.25rem;
        }

        .form-column {
            padding-top: 2.25rem;
        }

        .field-row {
            grid-template-columns: 1fr;
            gap: 1.5rem;
        }

        form {
            gap: 1.4rem;
        }

        button {
            width: 100%;
        }
    }
</style>
