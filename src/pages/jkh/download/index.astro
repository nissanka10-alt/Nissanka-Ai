---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { jkhEvent } from "../../../config/jkh.js";

const title = "Session Resource | Nissanka Advisory";
const description = "Resources from the John Keells Holdings executive session in Colombo.";
---

<BaseLayout {title} {description} path={jkhEvent.downloadPath} robots="noindex, nofollow">
    <section class="resource-ready" aria-labelledby="resource-title">
        <div class="shell resource-shell">
            <p class="system-label">Session resource</p>
            <h1 id="resource-title">{jkhEvent.slidesReady ? "Your slides are ready." : "Thank you for joining us."}</h1>
            <p class="intro">Thanks for joining the session. Keep the deck as a reference for the ideas and conversations that matter next.</p>

            {
                jkhEvent.slidesReady ? (
                    <a class="primary-action" href={jkhEvent.slidesPath} download>
                        Download the slides <span aria-hidden="true">→</span>
                    </a>
                ) : (
                    <p class="availability">The session deck will be available here shortly.</p>
                )
            }

            <nav class="resource-links" aria-label="Continue from this resource">
                <a href="/contact/">Continue the conversation <span aria-hidden="true">→</span></a>
                <a href="/">Explore Nissanka Advisory <span aria-hidden="true">→</span></a>
            </nav>
        </div>
    </section>
</BaseLayout>

<style>
    .resource-ready {
        min-height: min(42rem, 75vh);
        padding-block: clamp(4rem, 10vw, 9rem);
        background: var(--colour-paper);
    }

    .resource-shell {
        max-width: 62rem;
    }

    h1 {
        max-width: 10ch;
        margin: clamp(2.75rem, 7vw, 6rem) 0 1.75rem;
        font-family: var(--font-display);
        font-size: clamp(3.75rem, 8vw, 7.5rem);
        font-weight: 900;
        font-kerning: normal;
        font-feature-settings: "kern" 1;
        letter-spacing: normal;
        line-height: 0.95;
    }

    .intro {
        max-width: 42rem;
        margin: 0;
        font-size: clamp(1.1rem, 2vw, 1.35rem);
        line-height: 1.65;
    }

    .primary-action,
    .availability {
        display: inline-block;
        margin-top: clamp(2.5rem, 6vw, 4.5rem);
    }

    .primary-action {
        padding: 1rem 1.35rem;
        border: 1px solid var(--colour-black);
        background: var(--colour-black);
        color: var(--colour-white);
        font-family: var(--font-mono);
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-decoration: none;
        text-transform: uppercase;
    }

    .availability {
        padding-top: 1.25rem;
        border-top: var(--border-architectural);
        font-weight: 700;
    }

    .resource-links {
        display: flex;
        flex-wrap: wrap;
        gap: 1.25rem 2.5rem;
        margin-top: clamp(3.5rem, 8vw, 7rem);
        padding-top: 1.5rem;
        border-top: var(--border-architectural);
    }

    .resource-links a {
        color: inherit;
        text-underline-offset: 0.3em;
    }

    @media (max-width: 40rem) {
        .resource-ready {
            min-height: 0;
        }

        h1 {
            margin-top: 2.75rem;
            font-size: clamp(3.25rem, 16vw, 4.4rem);
            overflow-wrap: normal;
            word-break: normal;
            hyphens: none;
        }

        .resource-links {
            display: grid;
        }
    }
</style>
