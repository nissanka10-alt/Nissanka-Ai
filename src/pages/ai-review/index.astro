---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { Image } from "astro:assets";
import breakfastMeetingImage from "../../assets/editorial/breakfast-meeting.jpg";

const title = "AI Opportunity & Readiness Review | Nissanka Advisory";
const description = "Identify where AI can create meaningful value, understand organisational readiness and agree practical priorities, ownership and next steps.";

const usefulSituations = [
    {
        title: "Too many AI ideas. No shared priorities.",
        copy: "Leaders have opportunities to consider, but no consistent way to decide which ones are worth pursuing first.",
    },
    {
        title: "AI activity is already happening. Visibility is limited.",
        copy: "Different teams may be experimenting independently, making it difficult to see what is being used and where attention is needed.",
    },
    {
        title: "Leaders want to move forward without creating unnecessary risk.",
        copy: "There are questions about governance, data, adoption or capability that need to be understood before committing further.",
    },
    {
        title: "The organisation needs to understand how work may change.",
        copy: "AI may affect tasks, skills, roles and workforce decisions, but the practical implications are not yet clear.",
    },
];

const readinessAreas = [
    {
        number: "01",
        title: "Work",
        copy: "Where work is repetitive, difficult, slow or dependent on judgement.",
    },
    {
        number: "02",
        title: "People",
        copy: "Skills, confidence, adoption, behaviour and how teams are already using AI.",
    },
    {
        number: "03",
        title: "Data",
        copy: "Whether the information required to support useful AI applications is available, usable and appropriate.",
    },
    {
        number: "04",
        title: "Governance",
        copy: "Policies, decision rights, acceptable use, accountability and proportionate guardrails.",
    },
    {
        number: "05",
        title: "Technology",
        copy: "Existing platforms, AI tools, integration possibilities and technical constraints.",
    },
    {
        number: "06",
        title: "Leadership",
        copy: "Leadership priorities, decision-making, ownership and readiness for organisational change.",
    },
];

const stages = [
    {
        number: "01",
        title: "Discover",
        copy: "Understand how AI is being used today, where work is difficult and what leaders want to improve.",
        details: ["leadership priorities", "existing AI use", "operational friction", "current initiatives", "constraints"],
    },
    {
        number: "02",
        title: "Readiness",
        copy: "Look at people, data, governance, technology, leadership and organisational capability.",
        details: ["organisational conditions", "risks and dependencies", "capability gaps", "adoption considerations"],
    },
    {
        number: "03",
        title: "Prioritise",
        copy: "Identify the opportunities worth pursuing and distinguish quick wins from ideas that need more preparation.",
        details: ["potential value", "feasibility", "organisational readiness", "risk", "dependency"],
    },
    {
        number: "04",
        title: "Roadmap",
        copy: "Agree practical next steps, ownership and priorities for the months ahead.",
        details: ["immediate actions", "priorities", "ownership", "sequencing", "decisions still required"],
    },
];

const outputs = [
    {
        title: "Current State",
        copy: "A clear picture of how AI is being used today, including opportunities, gaps and areas that need attention.",
    },
    {
        title: "Opportunity Map",
        copy: "A prioritised view of the AI opportunities most worth exploring based on value, feasibility, readiness and risk.",
    },
    {
        title: "Recommendations",
        copy: "Practical recommendations across governance, people, data, technology and capability.",
    },
    {
        title: "Roadmap",
        copy: "Clear priorities, ownership and practical next steps for what happens next.",
    },
];

const valueOutcomes = [
    "clearer leadership priorities",
    "fewer disconnected experiments",
    "better visibility of AI use",
    "stronger alignment between opportunity and readiness",
    "earlier identification of governance or capability gaps",
    "a practical basis for deciding what to do next",
];

const workingMethods = [
    "leadership conversations",
    "focused interviews",
    "working sessions",
    "review of existing policies, plans or AI initiatives",
    "examination of selected workflows or use cases",
    "collaborative playback and prioritisation",
];

const advisoryAreas = [
    {
        title: "AI Strategy & Transformation",
        href: "/advisory/ai-strategy/",
        copy: "Shape practical governance, develop priority use cases and support responsible adoption and training.",
        linkText: "Explore AI Strategy",
    },
    {
        title: "Workforce Intelligence",
        href: "/advisory/workforce-intelligence/",
        copy: "Connect people data, skills and workforce planning to decisions about AI-enabled work and operating models.",
        linkText: "Explore Workforce Intelligence",
    },
    {
        title: "Leadership Readiness",
        href: "/advisory/leadership-readiness/",
        copy: "Prepare leaders for AI-enabled change, critical conversations and the insights needed to guide progress.",
        linkText: "Explore Leadership Readiness",
    },
];

const faqs = [
    {
        question: "Is this an AI audit?",
        answer: "No. It is a collaborative review designed to understand opportunity, readiness and priorities rather than inspect or certify the organisation.",
    },
    {
        question: "Do we need an AI strategy already?",
        answer: "No. The Review can help organisations that are just getting started as well as organisations already experimenting with AI.",
    },
    {
        question: "Is this mainly a technology review?",
        answer: "No. Technology is one part of the picture. The Review also considers work, people, data, governance and leadership.",
    },
    {
        question: "Who should be involved?",
        answer: "Usually a small group of leaders and subject-matter experts representing the areas relevant to the questions being explored.",
    },
    {
        question: "What do we receive?",
        answer: "Current State, Opportunity Map, Recommendations and Roadmap.",
    },
    {
        question: "Does the Review include implementation?",
        answer: "The Review establishes priorities and direction. Any implementation support is agreed separately if required.",
    },
    {
        question: "How long does it take?",
        answer: "The scope depends on the organisation and the questions being explored. Timing is agreed at the outset.",
    },
];

const structuredData = {
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "Service",
            "@id": "https://nissanka.co.uk/ai-review/#service",
            name: "AI Opportunity & Readiness Review",
            description,
            url: "https://nissanka.co.uk/ai-review/",
            provider: {
                "@type": "Organization",
                name: "Nissanka Advisory",
                url: "https://nissanka.co.uk/",
            },
        },
        {
            "@type": "BreadcrumbList",
            itemListElement: [
                {
                    "@type": "ListItem",
                    position: 1,
                    name: "Home",
                    item: "https://nissanka.co.uk/",
                },
                {
                    "@type": "ListItem",
                    position: 2,
                    name: "AI Opportunity & Readiness Review",
                    item: "https://nissanka.co.uk/ai-review/",
                },
            ],
        },
    ],
};
---

<BaseLayout {title} {description} path="/ai-review/" {structuredData}>
    <section class="review-hero" aria-labelledby="review-title">
        <div class="shell">
            <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "AI Opportunity & Readiness Review" }]} />
            <div class="review-hero__grid">
                <div class="review-hero__main">
                    <p class="system-label">01 / AI Opportunity &amp; Readiness Review</p>
                    <h1 id="review-title">Know where to start with AI.</h1>
                    <p class="review-hero__statement">A practical, collaborative review to understand where AI can create meaningful value, what needs attention first and which opportunities are worth pursuing.</p>
                </div>
                <div class="review-hero__support">
                    <p>Many organisations already have access to AI tools, experiments and ideas. The harder question is deciding where to focus, what the organisation is ready for and what should happen next.</p>
                    <div class="button-group">
                        <a class="button button--primary" href="mailto:gishan@nissanka.co.uk?subject=AI%20Opportunity%20and%20Readiness%20Review">Start with an AI Review</a>
                        <a class="text-link" href="#how-it-works">See how the Review works <span aria-hidden="true">↓</span></a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="review-section" aria-labelledby="the-review-title">
        <div class="shell">
            <p class="system-label">02 / The review</p>
            <div class="review-intro">
                <div class="review-intro__statement">
                    <h2 id="the-review-title">Clarity before commitment.</h2>
                    <p class="review-lens-line">Value / Readiness / Risk / Priorities</p>
                </div>
                <div class="review-prose">
                    <p class="review-intro__heading">A structured conversation about where AI can genuinely help.</p>
                    <p>The AI Opportunity &amp; Readiness Review is designed to create clarity before organisations invest further in AI.</p>
                    <p>It brings together the questions that are often considered separately: where AI is already being used, where work could improve, which opportunities are realistic, what risks need attention and whether the organisation is ready to scale.</p>
                    <p>The Review is not a technical inspection or a compliance exercise.</p>
                    <p>It is a collaborative process designed to help leadership teams make better decisions about what to pursue, what to prepare for and what to leave alone.</p>
                </div>
            </div>
        </div>
    </section>

    <section class="review-section useful-section" aria-labelledby="useful-title">
        <div class="shell">
            <p class="system-label">03 / When to use it</p>
            <div class="section-heading">
                <h2 id="useful-title">Useful when the organisation has more questions than answers.</h2>
            </div>
            <div class="situation-list">
                {usefulSituations.map((situation) => (
                    <article>
                        <h3>{situation.title}</h3>
                        <p>{situation.copy}</p>
                    </article>
                ))}
            </div>
        </div>
    </section>

    <section class="review-section readiness-section" aria-labelledby="readiness-title">
        <div class="shell">
            <p class="system-label">04 / Readiness</p>
            <div class="section-heading">
                <h2 id="readiness-title">AI readiness is more than technology.</h2>
            </div>
            <div class="readiness-grid">
                {readinessAreas.map((area) => (
                    <article class="readiness-area">
                        <p class="structural-number">{area.number}</p>
                        <h3>{area.title}</h3>
                        <p>{area.copy}</p>
                    </article>
                ))}
            </div>
        </div>
    </section>

    <section id="how-it-works" class="review-section process-section" aria-labelledby="process-title">
        <div class="shell">
            <p class="system-label">05 / How it works</p>
            <div class="section-heading">
                <h2 id="process-title">From uncertainty to a practical direction.</h2>
            </div>
            <ol class="process-grid">
                {stages.map((stage) => (
                    <li class="process-step">
                        <p class="process-step__label"><span>{stage.number}</span> / {stage.title}</p>
                        <p class="process-step__copy">{stage.copy}</p>
                        <ul>
                            {stage.details.map((detail) => <li>{detail}</li>)}
                        </ul>
                    </li>
                ))}
            </ol>
        </div>
    </section>

    <section class="review-section outputs-section" aria-labelledby="outputs-title">
        <div class="shell">
            <p class="system-label">06 / Outputs</p>
            <div class="section-heading">
                <h2 id="outputs-title">Clear enough to act on.</h2>
            </div>
            <ol class="output-sequence">
                {outputs.map((output, index) => (
                    <li class="output">
                        <p class="structural-number">{String(index + 1).padStart(2, "0")}</p>
                        <h3>{output.title}</h3>
                        <p>{output.copy}</p>
                    </li>
                ))}
            </ol>
        </div>
    </section>

    <section class="review-section value-section" aria-labelledby="value-title">
        <div class="shell">
            <p class="system-label">07 / The value</p>
            <div class="value-editorial">
                <div>
                    <h2 id="value-title">Better decisions before bigger investment.</h2>
                </div>
                <div class="value-editorial__copy">
                    <p class="lead-copy">The value of the Review is not another AI strategy document.</p>
                    <p>It is a shared understanding of where the organisation stands, where AI can genuinely help and what should happen next.</p>
                </div>
            </div>
            <ul class="outcome-list">
                {valueOutcomes.map((outcome) => <li>{outcome}</li>)}
            </ul>
        </div>
    </section>

    <section class="review-section working-section" aria-labelledby="working-title">
        <div class="shell">
            <p class="system-label">08 / How we work</p>
            <div class="working-editorial">
                <figure class="working-image">
                    <Image
                        src={breakfastMeetingImage}
                        alt="Group in discussion around a meeting table."
                        widths={[480, 720, 960, 1200]}
                        sizes="(max-width: 64rem) calc(100vw - 2rem), 58vw"
                        format="webp"
                        quality={82}
                        loading="lazy"
                    />
                </figure>
                <div class="working-content">
                    <div class="review-prose">
                        <h2 id="working-title">Focused, collaborative and proportionate.</h2>
                        <p class="lead-copy">The Review is shaped around the organisation rather than forcing every client through the same process.</p>
                        <p>The scope and depth are agreed at the start based on the organisation, the questions being explored and the level of work already underway.</p>
                    </div>
                    <div class="working-list">
                        <p class="system-label">It may include</p>
                        <ul>
                            {workingMethods.map((method) => <li>{method}</li>)}
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="review-section next-section" aria-labelledby="next-title">
        <div class="shell">
            <p class="system-label">09 / What comes next</p>
            <div class="section-heading section-heading--with-copy">
                <h2 id="next-title">The Review is a starting point, not a dependency.</h2>
                <p>The client should be able to use the Review independently. Where further support is useful, Nissanka Advisory may support connected areas through its wider <a href="/advisory/">advisory work</a>.</p>
            </div>
            <div class="next-grid">
                {advisoryAreas.map((area) => (
                    <article class="next-area">
                        <h3>{area.title}</h3>
                        <p>{area.copy}</p>
                        <a class="text-link" href={area.href}>{area.linkText} <span aria-hidden="true">→</span></a>
                    </article>
                ))}
            </div>
        </div>
    </section>

    <section class="review-section faq-section" aria-labelledby="faq-title">
        <div class="shell faq-layout">
            <div>
                <p class="system-label">10 / Questions</p>
                <h2 id="faq-title">Common questions.</h2>
            </div>
            <div class="faq-list">
                {faqs.map((faq) => (
                    <details>
                        <summary>{faq.question}</summary>
                        <p>{faq.answer}</p>
                    </details>
                ))}
            </div>
        </div>
    </section>

    <section class="review-final" aria-labelledby="start-title">
        <div class="shell review-final__grid">
            <div>
                <p class="system-label">11 / Start</p>
                <h2 id="start-title">Start with clarity.</h2>
            </div>
            <div>
                <p>If your organisation is exploring AI but the priorities are still unclear, the Review creates a practical place to begin.</p>
                <div class="button-group">
                    <a class="button button--inverse" href="mailto:gishan@nissanka.co.uk?subject=AI%20Opportunity%20and%20Readiness%20Review">Start with an AI Review</a>
                    <a class="text-link" href="mailto:gishan@nissanka.co.uk?subject=Advisory%20challenge">Discuss an advisory challenge <span aria-hidden="true">→</span></a>
                </div>
            </div>
        </div>
    </section>
</BaseLayout>

<style>
    .review-hero,
    .review-final {
        border-bottom: var(--border-architectural);
    }

    .review-hero {
        padding-block: 2rem clamp(5rem, 9vw, 8rem);
    }

    .review-hero :global(.breadcrumbs) {
        margin-bottom: clamp(4rem, 8vw, 7rem);
    }

    .review-hero__grid,
    .review-split,
    .review-intro,
    .value-editorial,
    .faq-layout,
    .review-final__grid,
    .section-heading--with-copy {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: var(--grid-gap);
    }

    .review-hero__main {
        grid-column: 1 / span 7;
    }

    .review-hero__support {
        grid-column: 9 / -1;
        align-self: end;
        padding-top: 1.25rem;
        border-top: var(--border-architectural);
    }

    h1 {
        max-width: 12ch;
        margin: 1.5rem 0 2rem;
        font-size: clamp(3.75rem, 5.2vw, 4rem);
        font-weight: 900;
        letter-spacing: -0.05em;
        line-height: 0.98;
    }

    .review-hero__statement {
        max-width: 46rem;
        margin: 0;
        font-size: 1.2rem;
        line-height: 1.6;
    }

    .review-hero__support > p {
        margin: 0;
    }

    .button-group {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem 1.5rem;
        margin-top: 2rem;
    }

    .button,
    .text-link {
        font-size: 0.875rem;
        font-weight: 700;
    }

    .button {
        display: inline-flex;
        min-height: 3.25rem;
        align-items: center;
        justify-content: center;
        padding: 0.8rem 1.1rem;
        border: 1px solid currentColor;
        text-decoration: none;
    }

    .button--primary {
        background: var(--colour-black);
        color: var(--colour-white);
    }

    .button--primary:hover,
    .button--primary:focus-visible {
        background: var(--colour-white);
        color: var(--colour-black);
    }

    .button--inverse {
        background: var(--colour-white);
        color: var(--colour-black);
    }

    .button--inverse:hover,
    .button--inverse:focus-visible {
        background: var(--colour-black);
        color: var(--colour-white);
    }

    .text-link {
        display: inline-block;
        text-underline-offset: 0.35em;
        text-decoration-thickness: 1px;
    }

    .text-link:hover {
        text-decoration-thickness: 2px;
    }

    .review-section,
    .review-final {
        padding-block: clamp(5rem, 9vw, 8rem);
    }

    .review-section h2,
    .review-final h2 {
        max-width: 18ch;
        margin: 1.5rem 0 0;
        font-size: clamp(2.5rem, 4vw, 2.875rem);
        font-weight: 600;
        letter-spacing: -0.035em;
        line-height: 1.05;
    }

    .review-split > :first-child {
        grid-column: 1 / span 7;
    }

    .review-split > :last-child {
        grid-column: 9 / -1;
    }

    .review-prose p {
        max-width: 45rem;
        margin: 1.5rem 0 0;
    }

    .review-intro__statement {
        grid-column: 1 / span 7;
    }

    .review-intro > .review-prose {
        grid-column: 9 / -1;
        align-self: end;
    }

    .review-intro__statement h2 {
        max-width: 11ch;
        font-family: var(--font-display);
        font-size: clamp(3.25rem, 5vw, 4.5rem);
        font-weight: 900;
        letter-spacing: -0.045em;
        line-height: 1;
    }

    .review-intro__heading {
        font-size: 1.35rem;
        font-weight: 600;
        letter-spacing: -0.025em;
        line-height: 1.3;
    }

    .review-lens-line {
        margin: 5rem 0 0;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }

    .lead-copy {
        font-size: 1.125rem;
        line-height: 1.65;
    }

    .section-heading {
        margin-bottom: 4rem;
    }

    .section-heading--with-copy {
        align-items: end;
    }

    .section-heading--with-copy h2 {
        grid-column: 1 / span 7;
    }

    .section-heading--with-copy > p {
        grid-column: 9 / -1;
        margin: 1.5rem 0 0;
    }

    .section-heading--with-copy a {
        text-underline-offset: 0.3em;
    }

    .situation-list {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: clamp(3rem, 7vw, 7rem) var(--grid-gap);
    }

    .situation-list article {
        max-width: 31rem;
    }

    .structural-number,
    .process-step__label {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
    }

    .situation-list h3 {
        margin: 0 0 1.25rem;
        font-size: 1.35rem;
        font-weight: 700;
        letter-spacing: -0.025em;
        line-height: 1.15;
        text-transform: uppercase;
    }

    .situation-list p {
        max-width: 29rem;
        margin: 0;
        line-height: 1.65;
    }

    .readiness-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        border-block: var(--border-architectural);
    }

    .readiness-area {
        min-height: 19rem;
        padding: 1.5rem;
    }

    .readiness-area:nth-child(2),
    .readiness-area:nth-child(3),
    .readiness-area:nth-child(5),
    .readiness-area:nth-child(6) {
        border-left: var(--border-architectural);
    }

    .readiness-area:nth-child(n + 4) {
        border-top: var(--border-architectural);
    }

    .structural-number {
        margin: 0;
    }

    .readiness-area h3,
    .output h3,
    .next-area h3 {
        margin: 4rem 0 1rem;
        font-size: 1.35rem;
        font-weight: 600;
        letter-spacing: -0.02em;
        line-height: 1.15;
        text-transform: uppercase;
    }

    .readiness-area > p:last-child,
    .output > p:last-child {
        margin: 0;
    }

    .process-section,
    .value-section {
        background: var(--colour-paper);
    }

    .process-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        margin: 0;
        padding: 0;
        border-block: var(--border-architectural);
        list-style: none;
    }

    .process-step {
        min-width: 0;
        padding: 1.5rem;
    }

    .process-step + .process-step {
        border-left: var(--border-architectural);
    }

    .process-step__label {
        margin: 0;
    }

    .process-step__label span {
        font-weight: 700;
    }

    .process-step__copy {
        min-height: 11rem;
        margin: 4rem 0 1.5rem;
    }

    .process-step ul,
    .working-list ul,
    .outcome-list {
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .process-step li,
    .working-list li,
    .outcome-list li {
        padding-block: 0.55rem;
        border-top: 1px solid #b5b3ae;
        font-size: 0.875rem;
    }

    .output-sequence {
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .output {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: var(--grid-gap);
        align-items: start;
        padding-block: clamp(2rem, 5vw, 4rem);
        border-top: var(--border-architectural);
    }

    .output:last-child {
        border-bottom: var(--border-architectural);
    }

    .output > .structural-number {
        grid-column: 1;
    }

    .output h3 {
        grid-column: 3 / span 4;
        margin: 0;
    }

    .output > p:last-child {
        grid-column: 8 / -1;
        font-size: 1.0625rem;
        line-height: 1.65;
    }

    .value-editorial > :first-child {
        grid-column: 1 / span 8;
    }

    .value-editorial__copy {
        grid-column: 9 / -1;
        align-self: end;
    }

    .value-section .value-editorial h2 {
        max-width: 13ch;
        font-family: var(--font-display);
        font-size: clamp(3.25rem, 5vw, 4.5rem);
        font-weight: 900;
        letter-spacing: -0.045em;
        line-height: 1;
    }

    .value-editorial__copy p {
        margin: 0 0 1.5rem;
    }

    .outcome-list {
        display: grid;
