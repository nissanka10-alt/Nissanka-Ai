---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Cta from "../../components/Cta.astro";
import "../../styles/advisory-pages.css";
import { contactHref } from "../../config/practices";

const title = "What We Do | Nissanka Advisory";
const description = "AI transformation and workforce intelligence advisory, supported by leadership capability where organisational change requires it.";

const corePathways = [
    {
        title: "AI & Transformation",
        copy: "Help organisations identify where AI can create value, establish the right governance and move from experimentation towards practical adoption.",
        href: "/advisory/ai-strategy/",
        linkText: "Explore AI & Transformation",
        capabilities: ["AI Opportunity & Readiness", "AI Strategy & Governance", "Use-Case Prioritisation", "Adoption & Training"],
    },
    {
        title: "Workforce Intelligence",
        copy: "Connect people, skills, work and capacity so workforce information supports real organisational decisions.",
        href: "/advisory/workforce-intelligence/",
        linkText: "Explore Workforce Intelligence",
        capabilities: ["People Data & Analytics", "Skills & Workforce Planning", "AI-Enabled Operating Models", "Workforce Intelligence"],
    },
];

const leadershipCapabilities = ["Leadership Development", "Leadership Coaching", "Critical Conversation Readiness", "Leading AI-Enabled Change", "Leadership Insights & Measurement"];

const structuredData = {
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "WebPage",
            "@id": "https://nissanka.co.uk/advisory/#webpage",
            url: "https://nissanka.co.uk/advisory/",
            name: title,
            description,
        },
        {
            "@type": "BreadcrumbList",
            itemListElement: [
                { "@type": "ListItem", position: 1, name: "Home", item: "https://nissanka.co.uk/" },
                { "@type": "ListItem", position: 2, name: "What We Do", item: "https://nissanka.co.uk/advisory/" },
            ],
        },
    ],
};
---

<BaseLayout {title} {description} path="/advisory/" {structuredData}>
    <section class="advisory-hero" aria-labelledby="advisory-title">
        <div class="shell">
            <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "What We Do" }]} />
            <p class="system-label">What We Do</p>
            <div class="advisory-hero__grid">
                <h1 id="advisory-title">AI and workforce decisions, considered together.</h1>
                <div class="advisory-hero__copy">
                    <p>Nissanka Advisory specialises in AI &amp; Transformation and Workforce Intelligence.</p>
                    <p>Leadership capability supports the work where change depends on judgement, confidence and the conversations leaders need to have.</p>
                    <Cta href="/ai-review/">Start with an AI Review</Cta>
                </div>
            </div>
        </div>
    </section>

    <section class="pathway-section" aria-labelledby="pathway-title">
        <div class="shell">
            <div class="pathway-intro">
                <p class="system-label">Primary advisory</p>
                <h2 id="pathway-title">Two core capabilities for practical organisational change.</h2>
                <p>The work connects technology opportunity with evidence about people, skills, capacity and how work is organised.</p>
            </div>
            <ul class="pathway-list">
                {corePathways.map((pathway) => (
                    <li>
                        <div>
                            <h3>{pathway.title}</h3>
                            <p>{pathway.copy}</p>
                            <ul>{pathway.capabilities.map((capability) => <li>{capability}</li>)}</ul>
                            <a class="text-link" href={pathway.href}>{pathway.linkText} <span aria-hidden="true">→</span></a>
                        </div>
                    </li>
                ))}
            </ul>
        </div>
    </section>

    <section class="supporting-section" aria-labelledby="supporting-title">
        <div class="shell supporting-grid">
            <div>
                <p class="system-label">Supporting capability</p>
                <h2 id="supporting-title">Leadership Advisory &amp; Development</h2>
            </div>
            <div>
                <p>Leadership capability can complement AI, workforce and organisational-change engagements, while remaining available as a standalone service where appropriate.</p>
                <ul>{leadershipCapabilities.map((capability) => <li>{capability}</li>)}</ul>
                <a class="text-link" href="/advisory/leadership/">Explore Leadership Advisory &amp; Development <span aria-hidden="true">→</span></a>
            </div>
        </div>
    </section>

    <section class="advisory-final" aria-labelledby="advisory-start-title">
        <div class="shell advisory-final__grid">
            <div>
                <p class="system-label">Where to start</p>
                <h2 id="advisory-start-title">Start with the question, not the solution.</h2>
            </div>
            <div>
                <p class="advisory-final__copy">Begin by identifying where AI can create value, what needs attention and what makes sense to do next.</p>
                <a class="cta-inverse" href="/ai-review/">Start with an AI Review</a>
                <a class="text-link secondary-contact" href={contactHref}>Start a Conversation <span aria-hidden="true">→</span></a>
            </div>
        </div>
    </section>
</BaseLayout>

<style>
    .advisory-hero {
        padding-block: 2rem clamp(6rem, 11vw, 10rem);
        border-bottom: var(--border-architectural);
    }

    .advisory-hero :global(.breadcrumbs) {
        margin-bottom: clamp(5rem, 10vw, 9rem);
    }

    .advisory-hero__grid {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: var(--grid-gap);
        align-items: end;
        margin-top: 1.5rem;
    }

    h1 {
        grid-column: 1 / span 7;
        max-width: 11ch;
        margin: 0;
        font-family: var(--font-display);
        font-feature-settings: "kern" 1;
        font-kerning: normal;
        font-size: clamp(3.75rem, 6vw, 5rem);
        letter-spacing: normal;
        line-height: 0.98;
    }

    .advisory-hero__copy {
        grid-column: 9 / -1;
    }

    .advisory-hero__copy p {
        margin: 0;
    }

    .advisory-hero__copy p + p {
        margin-top: 1.25rem;
    }

    .advisory-hero__copy :global(.cta) {
        margin-top: 2rem;
    }

    .pathway-section {
        padding-block: clamp(5rem, 9vw, 8rem);
        border-bottom: var(--border-architectural);
    }

    .supporting-section {
        padding-block: clamp(5rem, 9vw, 8rem);
        border-bottom: var(--border-architectural);
        background: var(--colour-paper);
    }

    .pathway-intro {
        max-width: 52rem;
    }

    .pathway-intro h2 {
        max-width: 13ch;
        margin: 1.5rem 0 2rem;
        font-size: clamp(2.75rem, 4.5vw, 3.75rem);
        letter-spacing: -0.04em;
    }

    .pathway-intro > p:last-child {
        max-width: 43rem;
        margin: 0;
        font-size: 1.125rem;
    }

    .pathway-list {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: var(--grid-gap);
        margin: clamp(4rem, 8vw, 7rem) 0 0;
        padding: 0;
        list-style: none;
    }

    .pathway-list li {
        padding-block: clamp(2rem, 5vw, 4rem);
        border-top: var(--border-architectural);
    }

    .pathway-list h3 {
        margin: 0 0 1rem;
        font-size: clamp(1.75rem, 3vw, 2.5rem);
        letter-spacing: -0.035em;
    }

    .pathway-list li > div > p {
        max-width: 47rem;
        margin: 0;
    }

    .pathway-list ul {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1.25rem;
        margin: 1.5rem 0 0;
        padding: 0;
        list-style: none;
        font-family: var(--font-mono);
        font-size: 0.7rem;
        text-transform: uppercase;
    }

    .supporting-grid {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: var(--grid-gap);
    }

    .supporting-grid > div:first-child {
        grid-column: 1 / span 6;
    }

    .supporting-grid > div:last-child {
        grid-column: 8 / -1;
    }

    .supporting-grid h2 {
        max-width: 13ch;
        margin: 1.5rem 0 0;
        font-size: clamp(2.5rem, 4vw, 3.5rem);
    }

    .supporting-grid > div:last-child > p {
        margin-top: 0;
        font-size: 1.125rem;
    }

    .supporting-grid ul {
        margin: 2rem 0 0;
        padding: 0;
        list-style: none;
        font-family: var(--font-mono);
        font-size: 0.7rem;
        text-transform: uppercase;
    }

    .supporting-grid li {
        padding-block: 0.55rem;
        border-top: var(--border-architectural);
    }

    .secondary-contact {
        margin-left: 1.25rem;
        color: inherit;
    }

    @media (max-width: 52rem) {
        .advisory-hero__grid,
        .supporting-grid {
            grid-template-columns: minmax(0, 1fr);
        }

        h1,
        .advisory-hero__copy,
        .supporting-grid > div:first-child,
        .supporting-grid > div:last-child {
            grid-column: 1;
        }

        .advisory-hero__copy,
        .supporting-grid > div:last-child {
            max-width: 42rem;
            margin-top: 3rem;
        }
    }

    @media (max-width: 42rem) {
        .pathway-list {
            grid-template-columns: 1fr;
        }

        .secondary-contact {
            display: block;
            margin-left: 0;
        }
    }
</style>
