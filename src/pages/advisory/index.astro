---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Cta from "../../components/Cta.astro";
import "../../styles/advisory-pages.css";
import { contactHref } from "../../config/practices";

const title = "What We Do | Nissanka Advisory";
const description = "A boutique advisory practice working across AI transformation, workforce intelligence and leadership advisory and development.";

const pathways = [
    {
        number: "01",
        title: "AI & Transformation",
        copy: "Help organisations identify where AI can create value, establish the right governance and move from experimentation towards practical adoption.",
        href: "/advisory/ai-strategy/",
        linkText: "Explore AI & Transformation",
        capabilities: ["AI Opportunity & Readiness", "AI Strategy & Governance", "Use-Case Prioritisation", "Adoption & Training"],
    },
    {
        number: "02",
        title: "Workforce Intelligence",
        copy: "Connect people, skills, work and capacity so workforce information supports real organisational decisions.",
        href: "/advisory/workforce-intelligence/",
        linkText: "Explore Workforce Intelligence",
        capabilities: ["People Data & Analytics", "Skills & Workforce Planning", "AI-Enabled Operating Models", "Workforce Intelligence"],
    },
    {
        number: "03",
        title: "Leadership Advisory & Development",
        copy: "Help leaders build the judgement, confidence and capability required to lead through organisational and technological change.",
        href: "/advisory/leadership/",
        linkText: "Explore Leadership Advisory & Development",
        capabilities: ["Leadership Development", "Leadership Coaching", "Critical Conversation Readiness", "Leading AI-Enabled Change", "Leadership Insights & Measurement"],
    },
];

const structuredData = {
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "WebPage",
            "@id": "https://nissanka.co.uk/advisory/#webpage",
            url: "https://nissanka.co.uk/advisory/",
            name: title,
            description,
        },
        {
            "@type": "BreadcrumbList",
            itemListElement: [
                { "@type": "ListItem", position: 1, name: "Home", item: "https://nissanka.co.uk/" },
                { "@type": "ListItem", position: 2, name: "What We Do", item: "https://nissanka.co.uk/advisory/" },
            ],
        },
    ],
};
---

<BaseLayout {title} {description} path="/advisory/" {structuredData}>
    <section class="advisory-hero" aria-labelledby="advisory-title">
        <div class="shell">
            <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "What We Do" }]} />
            <p class="system-label">What We Do</p>
            <div class="advisory-hero__grid">
                <h1 id="advisory-title">Three practices. One challenge: navigating change well.</h1>
                <div class="advisory-hero__copy">
                    <p>Technology, work and leadership change together.</p>
                    <p>Nissanka Advisory brings together AI & Transformation, Workforce Intelligence and Leadership Advisory & Development.</p>
                    <Cta href={contactHref}>Start a Conversation</Cta>
                </div>
            </div>
        </div>
    </section>

    <section class="pathway-section" aria-labelledby="pathway-title">
        <div class="shell">
            <div class="pathway-intro">
                <p class="system-label">Connected practices</p>
                <h2 id="pathway-title">AI, workforce and leadership considered together.</h2>
                <p>Each practice addresses a different part of organisational change. The right starting point depends on the decision leaders need to make.</p>
            </div>
            <ol class="pathway-list">
                {pathways.map((pathway) => (
                    <li>
                        <p class="pathway-number">{pathway.number}</p>
                        <div>
                            <h3>{pathway.title}</h3>
                            <p>{pathway.copy}</p>
                            <ul>{pathway.capabilities.map((capability) => <li>{capability}</li>)}</ul>
                            <a class="text-link" href={pathway.href}>{pathway.linkText} <span aria-hidden="true">→</span></a>
                        </div>
                    </li>
                ))}
            </ol>
        </div>
    </section>

    <section class="advisory-final" aria-labelledby="advisory-start-title">
        <div class="shell advisory-final__grid">
            <div>
                <p class="system-label">Where to start</p>
                <h2 id="advisory-start-title">Start with the question, not the solution.</h2>
            </div>
            <div>
                <p class="advisory-final__copy">Begin with the organisational decision, workforce question or leadership challenge that needs attention.</p>
                <a class="cta-inverse" href={contactHref}>Start a Conversation</a>
            </div>
        </div>
    </section>
</BaseLayout>

<style>
    .advisory-hero {
        padding-block: 2rem clamp(6rem, 11vw, 10rem);
        border-bottom: var(--border-architectural);
    }

    .advisory-hero :global(.breadcrumbs) {
        margin-bottom: clamp(5rem, 10vw, 9rem);
    }

    .advisory-hero__grid {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: var(--grid-gap);
        align-items: end;
        margin-top: 1.5rem;
    }

    h1 {
        grid-column: 1 / span 7;
        max-width: 11ch;
        margin: 0;
        font-family: var(--font-display);
        font-feature-settings: "kern" 1;
        font-kerning: normal;
        font-size: clamp(3.75rem, 6vw, 5rem);
        letter-spacing: normal;
        line-height: 0.98;
    }

    .advisory-hero__copy {
        grid-column: 9 / -1;
    }

    .advisory-hero__copy p {
        margin: 0;
    }

    .advisory-hero__copy p + p {
        margin-top: 1.25rem;
    }

    .advisory-hero__copy :global(.cta) {
        margin-top: 2rem;
    }

    .pathway-section {
        padding-block: clamp(5rem, 9vw, 8rem);
        border-bottom: var(--border-architectural);
    }

    .pathway-intro {
        max-width: 52rem;
    }

    .pathway-intro h2 {
        max-width: 13ch;
        margin: 1.5rem 0 2rem;
        font-size: clamp(2.75rem, 4.5vw, 3.75rem);
        letter-spacing: -0.04em;
    }

    .pathway-intro > p:last-child {
        max-width: 43rem;
        margin: 0;
        font-size: 1.125rem;
    }

    .pathway-list {
        margin: clamp(4rem, 8vw, 7rem) 0 0;
        padding: 0;
        list-style: none;
    }

    .pathway-list li {
        display: grid;
        grid-template-columns: minmax(4rem, 2fr) minmax(0, 10fr);
        gap: var(--grid-gap);
        padding-block: clamp(2rem, 5vw, 4rem);
        border-top: var(--border-architectural);
    }

    .pathway-number {
        margin: 0;
        font-family: var(--font-mono);
        font-size: 0.75rem;
    }

    .pathway-list h3 {
        margin: 0 0 1rem;
        font-size: clamp(1.75rem, 3vw, 2.5rem);
        letter-spacing: -0.035em;
    }

    .pathway-list li > div > p {
        max-width: 47rem;
        margin: 0;
    }

    .pathway-list ul {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1.25rem;
        margin: 1.5rem 0 0;
        padding: 0;
        list-style: none;
        font-family: var(--font-mono);
        font-size: 0.7rem;
        text-transform: uppercase;
    }

    @media (max-width: 52rem) {
        .advisory-hero__grid {
            grid-template-columns: minmax(0, 1fr);
        }

        h1,
        .advisory-hero__copy {
            grid-column: 1;
        }

        .advisory-hero__copy {
            max-width: 42rem;
            margin-top: 3rem;
        }
    }

    @media (max-width: 32rem) {
        .pathway-list li {
            grid-template-columns: 1fr;
        }
    }
</style>
