---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import PillarHero from "../../../../components/PillarHero.astro";
import { contactHref, nissankaCoaching } from "../../../../config/practices";
import "../../../../styles/advisory-pages.css";

const title = "Leadership Coaching | Nissanka Advisory";
const description = "Leadership coaching for organisations supporting leaders through complexity, growth, change and consequential decisions.";
const structuredData = { "@context": "https://schema.org", "@graph": [
    { "@type": "Service", "@id": "https://nissanka.co.uk/advisory/leadership/coaching/#service", name: "Leadership Coaching", description, url: "https://nissanka.co.uk/advisory/leadership/coaching/", provider: { "@type": "Organization", name: "Nissanka Advisory", url: "https://nissanka.co.uk/" }, audience: { "@type": "Audience", audienceType: "Organisations commissioning leadership coaching" } },
    { "@type": "BreadcrumbList", itemListElement: [{ "@type": "ListItem", position: 1, name: "Home", item: "https://nissanka.co.uk/" }, { "@type": "ListItem", position: 2, name: "What We Do", item: "https://nissanka.co.uk/advisory/" }, { "@type": "ListItem", position: 3, name: "Leadership Advisory & Development", item: "https://nissanka.co.uk/advisory/leadership/" }, { "@type": "ListItem", position: 4, name: "Leadership Coaching", item: "https://nissanka.co.uk/advisory/leadership/coaching/" }] },
] };
---

<BaseLayout {title} {description} path="/advisory/leadership/coaching/" {structuredData}>
    <PillarHero label="Leadership Coaching" heading="Space to think clearly when the decisions matter." breadcrumbs={[{ label: "Home", href: "/" }, { label: "What We Do", href: "/advisory/" }, { label: "Leadership", href: "/advisory/leadership/" }, { label: "Coaching" }]} primaryHref={contactHref} primaryText="Start a Conversation" secondaryHref="#coaching-purpose" secondaryText="Explore Leadership Coaching">
        <p>Leadership coaching creates dedicated space for leaders to think clearly, examine patterns, work through difficult decisions and develop how they lead.</p>
        <p>This page is primarily for organisations considering coaching as part of leadership support and development.</p>
    </PillarHero>

    <section id="coaching-purpose" class="pillar-section editorial-statement" aria-labelledby="statement-title"><div class="shell editorial-statement__grid"><div class="editorial-statement__title"><p class="system-label">The purpose</p><h2 id="statement-title">A confidential space for consequential leadership work.</h2></div><div class="editorial-statement__copy"><p>Coaching can help a leader slow down, understand what is shaping a decision and consider how they want to act.</p><p class="lead-copy">The focus is not generic advice. It is clearer thinking, greater self-awareness and more deliberate leadership practice.</p></div></div></section>

    <section class="pillar-section" aria-labelledby="contexts-title"><div class="shell section-split"><div><p class="system-label">When it may help</p><h2 id="contexts-title">Complexity, growth, change and difficult decisions.</h2></div><div class="section-copy"><p>Leadership coaching may be useful when a leader is taking on wider responsibility, working through organisational change, navigating a difficult relationship or decision, or examining patterns that affect how they lead.</p><p>The scope and coaching relationship are agreed around the individual and organisational context.</p></div></div></section>

    <section class="pillar-section specialist-section" aria-labelledby="specialist-title"><div class="shell section-split"><div><p class="system-label">Specialist practice</p><h2 id="specialist-title">Coaching depth through {nissankaCoaching.brand}.</h2></div><div class="section-copy"><p>Leadership Coaching is delivered through the Nissanka leadership practice, with specialist coaching depth provided through {nissankaCoaching.brand}.</p><p>{nissankaCoaching.brand} is being developed as a separate specialist brand covering coaching, mentoring and coaching supervision. Its website link will be added here once the new site is approved and live.</p></div></div></section>

    <section class="pillar-section" aria-labelledby="related-title"><div class="shell connection-heading"><p class="system-label">This connects to</p><h2 id="related-title">Individual reflection and organisational capability.</h2><p>Coaching supports the individual leader. Leadership development can build shared capability across a team or organisation.</p><a class="text-link" href="/advisory/leadership/development/">Explore Leadership Development <span aria-hidden="true">→</span></a></div></section>
    <section class="advisory-final" aria-labelledby="final-title"><div class="shell advisory-final__grid"><div><p class="system-label">Start</p><h2 id="final-title">Consider what the leader needs space to work through.</h2></div><div><p class="advisory-final__copy">Discuss whether leadership coaching is the right form of support.</p><a class="cta-inverse" href={contactHref}>Start a Conversation</a></div></div></section>
</BaseLayout>

<style>.specialist-section{background:var(--colour-paper)}</style>
