---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Nissanka Advisory | AI, Workforce & Leadership Advisory";
const description = "Nissanka Advisory helps organisations identify valuable AI opportunities, strengthen workforce intelligence and prepare leaders for AI-enabled change.";

const pillars = [
    {
        number: "01",
        title: "AI Strategy & Transformation",
        copy: "Identify where AI can create value, establish practical governance and move from experimentation towards responsible adoption.",
        link: "/advisory/ai-strategy/",
        linkText: "Explore AI Strategy",
    },
    {
        number: "02",
        title: "Workforce Intelligence",
        copy: "Turn people, skills and workforce data into better decisions about capability, capacity, planning and how work is organised.",
        link: "/advisory/workforce-intelligence/",
        linkText: "Explore Workforce Intelligence",
    },
    {
        number: "03",
        title: "Leadership Readiness",
        copy: "Prepare leaders for the decisions, conversations and behavioural shifts required in AI-enabled organisations.",
        link: "/advisory/leadership-readiness/",
        linkText: "Explore Leadership Readiness",
    },
];

const stages = [
    {
        number: "01",
        title: "Discover",
        copy: "Understand how AI is being used today, where work is difficult and what leaders want to improve.",
    },
    {
        number: "02",
        title: "Readiness",
        copy: "Look at people, data, governance, technology, leadership and organisational capability.",
    },
    {
        number: "03",
        title: "Prioritise",
        copy: "Identify the opportunities worth pursuing and distinguish quick wins from ideas that need more preparation.",
    },
    {
        number: "04",
        title: "Roadmap",
        copy: "Agree practical next steps, ownership and priorities for the months ahead.",
    },
];

const organisations = ["Vodafone", "EY", "Worldline", "Nscale"];
const events = [
    "Chief AI Officer Summit UK",
    "TechEx London",
    "TechEx Amsterdam",
    "CWI Dubai",
    "CDAO UK",
    "People Analytics World",
    "CIPD Annual Conference",
];
---

<BaseLayout {title} {description} path="/">
    <section class="home-hero" aria-labelledby="home-title">
        <div class="shell home-hero__grid">
            <div class="home-hero__main">
                <p class="system-label">01 / Nissanka Advisory</p>
                <h1 id="home-title">AI can do the task.<br />It cannot own the work.</h1>
                <p class="home-hero__lede">Nissanka Advisory helps organisations make better decisions about AI, people and work — identifying where AI can create value, strengthening workforce intelligence and preparing leaders for AI-enabled change.</p>
                <div class="button-group" aria-label="Homepage introduction actions">
                    <a class="button button--primary" href="/ai-review/">Start with an AI Review</a>
                    <a class="text-link" href="/advisory/">Explore Advisory <span aria-hidden="true">→</span></a>
                </div>
            </div>
            <aside class="hero-lenses" aria-label="Advisory lenses">
                <p class="system-label">AI / Workforce / Leadership</p>
                <p>Three connected lenses for organisations deciding how work should change.</p>
            </aside>
        </div>
    </section>

    <section class="home-section start-section" aria-labelledby="start-title">
        <div class="shell">
            <p class="system-label">02 / Where to start</p>
            <div class="editorial-split">
                <h2 id="start-title">Know where to start with AI.</h2>
                <div class="prose-block">
                    <p class="lead-copy">The AI Opportunity &amp; Readiness Review helps leadership teams understand where AI can create meaningful value, what needs attention first and which opportunities are worth pursuing.</p>
                    <p>This is not a technical inspection or compliance exercise. It is a structured, collaborative review of how AI is being used today, where work could improve and what the organisation is ready to do next.</p>
                    <a class="text-link" href="/ai-review/">Explore the AI Opportunity &amp; Readiness Review <span aria-hidden="true">→</span></a>
                </div>
            </div>
        </div>
    </section>

    <section class="home-section advisory-section" aria-labelledby="advisory-title">
        <div class="shell">
            <p class="system-label">03 / Advisory</p>
            <div class="section-heading">
                <h2 id="advisory-title">AI changes more than technology.</h2>
                <p>The work sits across strategy, workforce decisions and leadership readiness.</p>
            </div>
            <div class="pillar-grid">
                {pillars.map((pillar) => (
                    <article class="pillar">
                        <p class="pillar__number">{pillar.number}</p>
                        <h3>{pillar.title}</h3>
                        <p>{pillar.copy}</p>
                        <a class="text-link" href={pillar.link}>{pillar.linkText} <span aria-hidden="true">→</span></a>
                    </article>
                ))}
            </div>
        </div>
    </section>

    <section class="home-section methodology-section" aria-labelledby="method-title">
        <div class="shell">
            <p class="system-label">04 / The review</p>
            <div class="section-heading section-heading--compact">
                <h2 id="method-title">From uncertainty to a practical direction.</h2>
            </div>
            <ol class="method-grid">
                {stages.map((stage) => (
                    <li class="method-step">
                        <p class="method-step__label"><span>{stage.number}</span> / {stage.title}</p>
                        <p>{stage.copy}</p>
                    </li>
                ))}
            </ol>
            <a class="text-link" href="/ai-review/">Understand the AI Review <span aria-hidden="true">→</span></a>
        </div>
    </section>

    <section class="home-section experience-section" aria-labelledby="experience-title">
        <div class="shell">
            <p class="system-label">05 / Experience</p>
            <div class="editorial-split">
                <div>
                    <h2 id="experience-title">Built from working inside transformation.</h2>
                </div>
                <p class="lead-copy">The approach draws on experience across people technology, workforce analytics, AI adoption and organisational transformation in complex international environments.</p>
            </div>
            <div class="experience-editorial">
                <section class="experience-selected" aria-labelledby="selected-experience-title">
                    <h3 id="selected-experience-title" class="system-label">Selected experience</h3>
                    <ul aria-label="Selected professional experience">
                        {organisations.map((organisation) => <li>{organisation}</li>)}
                    </ul>
                    <p>Professional experience, not a list of Nissanka Advisory clients.</p>
                </section>
                <div class="experience-details">
                    <section aria-labelledby="academic-title">
                        <h3 id="academic-title" class="system-label">Academic</h3>
                        <ul>
                            <li><strong>Guest Lecturer</strong> — UCL</li>
                            <li><strong>Associate Lecturer</strong> — Buckinghamshire New University</li>
                        </ul>
                    </section>
                    <section aria-labelledby="education-title">
                        <h3 id="education-title" class="system-label">Education</h3>
                        <ul>
                            <li>MBA</li>
                            <li>MSc Business Information Technology</li>
                            <li>Oxford AI Programme</li>
                            <li>LSE Ethics of AI programme</li>
                        </ul>
                    </section>
                </div>
            </div>
        </div>
    </section>

    <section class="home-section ideas-section" aria-labelledby="ideas-title">
        <div class="shell ideas-layout">
            <div>
                <p class="system-label">06 / Ideas</p>
                <h2 id="ideas-title">The Work AI Cannot Do</h2>
            </div>
            <div class="ideas-copy">
                <p class="ideas-statement">AI can do the task.<br />It cannot own the work.</p>
                <p>A developing body of ideas about judgement, workforce intelligence, leadership and the design of human-AI work.</p>
                <a class="text-link" href="/ideas/">Explore Ideas <span aria-hidden="true">→</span></a>
            </div>
        </div>
    </section>

    <section class="home-section speaking-section" aria-labelledby="speaking-title">
        <div class="shell">
            <p class="system-label">07 / Speaking</p>
            <div class="editorial-split editorial-split--dark">
                <div>
                    <h2 id="speaking-title">Ideas designed for the room.</h2>
                    <p class="lead-copy">Keynotes, leadership sessions and executive conversations on AI, workforce intelligence and how work changes.</p>
                    <p>More than 50 keynotes, presentations and leadership sessions.</p>
                    <a class="text-link" href="/speaking/">Explore Speaking <span aria-hidden="true">→</span></a>
                </div>
                <div class="event-list">
                    <p class="system-label">Selected previous events</p>
                    <ul>
                        {events.map((event) => <li>{event}</li>)}
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <section class="home-section about-section" aria-labelledby="about-title">
        <div class="shell">
            <p class="system-label">08 / About</p>
            <div class="editorial-split">
                <h2 id="about-title">Technology changes.<br />The work still has to make sense.</h2>
                <div class="prose-block">
                    <p class="lead-copy">Gishan Nissanka brings experience across people technology, workforce analytics, HR systems, AI adoption and organisational transformation.</p>
                    <p>His background spans Vodafone, EY, Worldline and Nscale, alongside academic work as a guest and associate lecturer.</p>
                    <a class="text-link" href="/about/">About Gishan <span aria-hidden="true">→</span></a>
                </div>
            </div>
        </div>
    </section>

    <section class="final-cta" aria-labelledby="final-cta-title">
        <div class="shell final-cta__grid">
            <h2 id="final-cta-title">Not sure where to start with AI?</h2>
            <div>
                <p>Start with a structured conversation about where AI can create value, what needs attention and what makes sense to do next.</p>
                <div class="button-group">
                    <a class="button button--inverse" href="/ai-review/">Start with an AI Review</a>
                    <a class="text-link" href="mailto:gishan@nissanka.co.uk?subject=Advisory%20challenge">Discuss an advisory challenge <span aria-hidden="true">→</span></a>
                </div>
            </div>
        </div>
    </section>
</BaseLayout>

<style>
    .home-hero,
    .final-cta {
        border-bottom: var(--border-architectural);
    }

    .home-hero {
        padding-block: clamp(5rem, 10vw, 9rem);
    }

    .home-hero__grid,
    .editorial-split,
    .ideas-layout,
    .final-cta__grid {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: var(--grid-gap);
    }

    .home-hero__main {
        grid-column: 1 / span 9;
        min-width: 0;
    }

    .home-hero h1 {
        max-width: 18ch;
        margin: 1.75rem 0 2.25rem;
        font-family: var(--font-display);
        font-size: clamp(4.75rem, 6.4vw, 5.125rem);
        font-weight: 900;
        letter-spacing: -0.045em;
        line-height: 0.98;
    }

    .home-hero__lede {
        max-width: 48rem;
        margin: 0;
        font-size: 1.125rem;
        line-height: 1.65;
    }

    .hero-lenses {
        grid-column: 10 / -1;
        align-self: end;
        padding-block: 1.25rem 1.5rem;
        border-block: var(--border-architectural);
    }

    .hero-lenses p:last-child {
        max-width: 24rem;
        margin: 3rem 0 0;
        font-size: 1rem;
        line-height: 1.55;
    }

    .button-group {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem 1.75rem;
        margin-top: 2.25rem;
    }

    .button,
    .text-link {
        font-size: 0.875rem;
        font-weight: 700;
    }

    .button {
        display: inline-flex;
        min-height: 3.25rem;
        align-items: center;
        justify-content: center;
        padding: 0.8rem 1.1rem;
        border: 1px solid currentColor;
        text-decoration: none;
    }

    .button--primary {
        background: var(--colour-black);
        color: var(--colour-white);
    }

    .button--primary:hover,
    .button--primary:focus-visible {
        background: var(--colour-white);
        color: var(--colour-black);
    }

    .button--inverse {
        background: var(--colour-white);
        color: var(--colour-black);
    }

    .button--inverse:hover,
    .button--inverse:focus-visible {
        background: var(--colour-black);
        color: var(--colour-white);
    }

    .text-link {
        display: inline-block;
        text-underline-offset: 0.35em;
        text-decoration-thickness: 1px;
    }

    .text-link:hover {
        text-decoration-thickness: 2px;
    }

    .home-section,
    .final-cta {
        padding-block: clamp(5rem, 9vw, 8rem);
    }

    .editorial-split > :first-child {
        grid-column: 1 / span 6;
    }

    .editorial-split > :last-child {
        grid-column: 8 / -1;
    }

    .home-section h2,
    .final-cta h2 {
        max-width: 16ch;
        margin: 1.5rem 0 0;
        font-size: clamp(2.5rem, 4vw, 2.875rem);
        font-weight: 600;
        letter-spacing: -0.035em;
        line-height: 1.05;
    }

    .prose-block,
    .editorial-split > .lead-copy {
        padding-top: 1.5rem;
    }

    .prose-block p,
    .editorial-split > .lead-copy,
    .section-heading p,
    .ideas-copy,
    .final-cta__grid > div {
        max-width: 39rem;
    }

    .prose-block p,
    .ideas-copy > p,
    .final-cta__grid > div > p {
        margin: 0 0 1.5rem;
    }

    .lead-copy {
        font-size: 1.125rem;
        line-height: 1.65;
    }

    .start-section {
        border-top: 1px solid var(--colour-black);
    }

    .section-heading {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: var(--grid-gap);
        align-items: end;
        margin-bottom: 4rem;
    }

    .section-heading h2 {
        grid-column: 1 / span 7;
    }

    .section-heading p {
        grid-column: 9 / -1;
        margin: 1.5rem 0 0;
    }

    .section-heading--compact h2 {
        grid-column: 1 / span 8;
    }

    .pillar-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        border-top: var(--border-architectural);
    }

    .pillar {
        display: flex;
        min-width: 0;
        min-height: 24rem;
        flex-direction: column;
        padding: 1.5rem;
    }

    .pillar + .pillar {
        border-left: var(--border-architectural);
    }

    .pillar__number,
    .method-step__label {
        margin: 0;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
    }

    .pillar h3 {
        max-width: 17rem;
        margin: 4.5rem 0 1.5rem;
        font-size: 1.45rem;
        font-weight: 600;
        letter-spacing: -0.025em;
        line-height: 1.15;
        text-transform: uppercase;
    }

    .pillar > p:not(.pillar__number) {
        margin: 0 0 2rem;
    }

    .pillar .text-link {
        margin-top: auto;
    }

    .methodology-section {
        border-top: var(--border-architectural);
        background: var(--colour-white);
    }

    .method-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        margin: 4rem 0 2.5rem;
        padding: 0;
        border-block: var(--border-architectural);
        list-style: none;
    }

    .method-step {
        min-width: 0;
        padding: 1.5rem;
    }

    .method-step + .method-step {
        border-left: var(--border-architectural);
    }

    .method-step__label span {
        font-weight: 700;
    }

    .method-step > p:last-child {
        margin: 5rem 0 0;
    }

    .experience-editorial {
        display: grid;
        grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
        gap: clamp(3rem, 7vw, 7rem);
        margin-top: 5rem;
        padding-top: 1.5rem;
        border-top: var(--border-architectural);
    }

    .experience-editorial h3 {
        margin: 0;
    }

    .experience-selected ul,
    .experience-details ul {
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .experience-selected ul {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1.5rem;
        margin-top: 3rem;
    }

    .experience-selected li {
        font-size: clamp(1.75rem, 3vw, 2.5rem);
        font-weight: 600;
        letter-spacing: -0.04em;
        line-height: 1.1;
    }

    .experience-selected li:not(:last-child)::after {
        margin-left: 1.5rem;
        color: var(--colour-silver);
        content: "/";
        font-family: var(--font-mono);
        font-size: 0.9rem;
        vertical-align: middle;
    }

    .experience-selected > p {
        max-width: 27rem;
        margin: 2.5rem 0 0;
        color: #555555;
        font-size: 0.8rem;
    }

    .experience-details {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: clamp(2rem, 5vw, 5rem);
    }

    .experience-details ul {
        margin-top: 3rem;
    }

    .experience-details li {
        margin-bottom: 1.25rem;
    }

    .experience-details strong {
        font-weight: 600;
    }

    .ideas-section {
        padding-block: clamp(7rem, 12vw, 11rem);
        background: var(--colour-paper);
    }

    .ideas-layout > :first-child {
        grid-column: 1 / span 7;
    }

    .ideas-layout > :last-child {
        grid-column: 9 / -1;
    }

    .ideas-section h2 {
        max-width: 10ch;
        margin-top: 2.5rem;
        font-family: var(--font-display);
        font-size: clamp(3rem, 5vw, 3.5rem);
        font-weight: 900;
        letter-spacing: -0.045em;
        line-height: 1;
    }

    .ideas-copy {
        align-self: end;
        padding-top: 2rem;
    }

    .ideas-statement {
        font-family: var(--font-display);
        font-size: 1.75rem;
        font-weight: 900;
        line-height: 1.15;
    }

    .speaking-section,
    .final-cta {
        border-color: var(--colour-white);
        background: var(--colour-obsidian);
        color: var(--colour-white);
    }

    .editorial-split--dark > :first-child {
        padding-right: 2rem;
    }

    .speaking-section h2 {
        max-width: 11ch;
    }

    .speaking-section .lead-copy {
        max-width: 35rem;
        margin: 2rem 0 1.5rem;
    }

    .speaking-section .text-link {
        margin-top: 1rem;
    }

    .event-list {
        border-top: 1px solid var(--colour-white);
    }

    .event-list .system-label {
        padding-top: 1.25rem;
    }

    .event-list ul {
        margin: 2.5rem 0 0;
        padding: 0;
        list-style: none;
    }

    .event-list li {
        padding: 0.45rem 0;
    }

    .final-cta__grid h2 {
        grid-column: 1 / span 7;
        max-width: 12ch;
        margin: 0;
        font-size: clamp(2.75rem, 5vw, 3.5rem);
    }

    .final-cta__grid > div {
        grid-column: 9 / -1;
        align-self: end;
    }

    @media (max-width: 64rem) {
        .home-hero__main {
            grid-column: 1 / -1;
        }

        .home-hero h1 {
            font-size: clamp(4rem, 8vw, 4.75rem);
        }

        .hero-lenses {
            grid-column: 7 / -1;
            margin-top: 3rem;
        }

        .pillar h3 {
            margin-top: 3rem;
        }

        .method-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .method-step:nth-child(3) {
            border-left: 0;
            border-top: var(--border-architectural);
        }

        .method-step:nth-child(4) {
            border-top: var(--border-architectural);
        }
    }

    @media (max-width: 48rem) {
        .home-hero,
        .home-section,
        .final-cta {
            padding-block: 4.5rem;
        }

        .home-hero__grid,
        .editorial-split,
        .ideas-layout,
        .final-cta__grid,
        .section-heading {
            grid-template-columns: 1fr;
        }

        .home-hero__main,
        .hero-lenses,
        .editorial-split > :first-child,
        .editorial-split > :last-child,
        .ideas-layout > :first-child,
        .ideas-layout > :last-child,
        .final-cta__grid h2,
        .final-cta__grid > div,
        .section-heading h2,
        .section-heading p,
        .section-heading--compact h2 {
            grid-column: 1;
        }

        .home-hero h1 {
            margin-block: 1.5rem 2rem;
            font-size: clamp(2.75rem, 13vw, 3.125rem);
        }

        .home-hero__lede {
            font-size: 1rem;
        }

        .hero-lenses {
            margin-top: 3.5rem;
        }

        .hero-lenses p:last-child {
            margin-top: 2rem;
        }

        .home-section h2,
        .final-cta h2 {
            font-size: clamp(2.35rem, 10vw, 2.75rem);
        }

        .prose-block,
        .editorial-split > .lead-copy {
            padding-top: 0.5rem;
        }

        .section-heading {
            margin-bottom: 2.5rem;
        }

        .section-heading p {
            margin-top: 0;
        }

        .pillar-grid,
        .method-grid,
        .experience-editorial,
        .experience-details {
            grid-template-columns: 1fr;
        }

        .pillar {
            min-height: 0;
            padding: 1.5rem 0;
        }

        .pillar + .pillar,
        .method-step + .method-step,
        .experience-editorial > * + * {
            border-top: var(--border-architectural);
            border-left: 0;
        }

        .pillar h3 {
            margin: 2.5rem 0 1rem;
        }

        .pillar .text-link {
            margin-top: 1rem;
        }

        .method-grid {
            margin-top: 2.5rem;
        }

        .method-step {
            padding: 1.5rem 0;
        }

        .method-step:nth-child(3),
        .method-step:nth-child(4) {
            border-top: var(--border-architectural);
        }

        .method-step > p:last-child {
            margin-top: 2.5rem;
        }

        .experience-editorial {
            gap: 3rem;
            margin-top: 3rem;
        }

        .experience-details {
            padding-top: 3rem;
            border-top: 0;
        }

        .experience-selected li:not(:last-child)::after {
            margin-left: 0.75rem;
        }

        .ideas-section h2 {
            font-size: clamp(2.75rem, 13vw, 3.25rem);
        }

        .ideas-copy {
            margin-top: 2rem;
        }

        .editorial-split--dark > :first-child {
            padding-right: 0;
        }

        .event-list {
            margin-top: 3.5rem;
        }

        .final-cta__grid > div {
            margin-top: 2rem;
        }
    }

    @media (max-width: 26rem) {
        .button-group,
        .button {
            width: 100%;
        }

        .button-group {
            align-items: flex-start;
        }

        .button-group .text-link {
            width: auto;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
            scroll-behavior: auto !important;
            transition-duration: 0.01ms !important;
            animation-duration: 0.01ms !important;
            animation-iteration-count: 1 !important;
        }
    }
</style>
