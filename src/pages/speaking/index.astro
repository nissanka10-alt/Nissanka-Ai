---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import speakingImage from "../../assets/editorial/pa-world-2025.jpg";
import "../../styles/editorial-pages.css";

const title = "Gishan Nissanka | Speaking on AI, Work & Workforce Intelligence";
const description = "Keynotes, leadership sessions and executive conversations on AI, workforce intelligence, judgement and how organisations redesign work.";
const events = ["Chief AI Officer Summit UK", "TechEx London", "TechEx Amsterdam", "CWI Dubai", "CDAO UK", "People Analytics World", "CIPD Annual Conference"];
const formats = [
    ["Keynote", "A focused point of view designed for conferences, leadership audiences and organisational events."],
    ["Fireside Conversation", "A responsive discussion that connects the central ideas to the questions in the room."],
    ["Panel", "A practical contribution to wider conversations about AI, work, people and leadership."],
    ["Executive Workshop", "A facilitated session that helps leaders examine the implications for their organisation."],
];
const structuredData = {
    "@context": "https://schema.org",
    "@graph": [
        { "@type": "ProfilePage", "@id": "https://nissanka.co.uk/speaking/#webpage", url: "https://nissanka.co.uk/speaking/", name: title, description, mainEntity: { "@id": "https://nissanka.co.uk/#gishan-nissanka" } },
        { "@type": "Person", "@id": "https://nissanka.co.uk/#gishan-nissanka", name: "Gishan Nissanka", jobTitle: "People Technology and AI Transformation leader", url: "https://nissanka.co.uk/about/" },
        { "@type": "BreadcrumbList", itemListElement: [
            { "@type": "ListItem", position: 1, name: "Home", item: "https://nissanka.co.uk/" },
            { "@type": "ListItem", position: 2, name: "Speaking", item: "https://nissanka.co.uk/speaking/" },
        ] },
    ],
};
---

<BaseLayout {title} {description} path="/speaking/" {structuredData}>
    <section class="editorial-page-hero speaking-hero" aria-labelledby="speaking-title">
        <div class="shell">
            <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Speaking" }]} />
            <p class="system-label">01 / Speaking</p>
            <div class="speaking-hero__grid">
                <figure><Image src={speakingImage} alt="Speaker presenting to an audience at a conference." widths={[480, 720, 960, 1200]} sizes="(max-width: 52rem) calc(100vw - 2rem), 54vw" format="webp" quality={82} /></figure>
                <div>
                    <h1 id="speaking-title">Ideas designed for the room.</h1>
                    <p class="lead-copy">Keynotes, leadership sessions and executive conversations on AI, workforce intelligence and how work changes.</p>
                    <p class="credibility">More than 50 keynotes, presentations and leadership sessions.</p>
                    <a class="hero-cta" href="mailto:gishan@nissanka.co.uk?subject=Speaking%20enquiry">Enquire about speaking</a>
                </div>
            </div>
        </div>
    </section>

    <section class="editorial-section editorial-paper" aria-labelledby="keynote-title">
        <div class="shell keynote-layout">
            <div><p class="system-label">02 / Signature keynote</p><h2 id="keynote-title">The Work AI Cannot Do</h2><p class="keynote-subtitle">How Leaders Redesign Work, Skills and Decisions in the Age of AI</p></div>
            <div><p>AI can increasingly perform tasks that once required human effort.</p><p>The leadership challenge is deciding what work should change, where human judgement remains essential and how organisations redesign roles, skills and decisions around new capabilities.</p><p>Audiences are invited to examine practical questions about work design, judgement, skills, workforce intelligence, leadership and human-AI collaboration.</p></div>
        </div>
    </section>

    <section class="editorial-section" aria-labelledby="themes-title"><div class="shell"><p class="system-label">03 / Supporting themes</p><h2 id="themes-title">Questions that connect technology to work.</h2><div class="speaking-themes"><article><h3>From AI Pilots to Practical Adoption</h3><p>How organisations move from experimentation to AI that people can use safely and productively in real work.</p></article><article><h3>The Judgement Gap</h3><p>How AI changes which capabilities organisations value, where human judgement becomes more important and how workforce intelligence shapes human-AI work.</p></article></div></div></section>

    <section class="editorial-section editorial-dark" aria-labelledby="formats-title"><div class="shell"><p class="system-label">04 / Formats</p><h2 id="formats-title">Built for the context and the room.</h2><div class="format-list">{formats.map((format, index) => <article><p>0{index + 1}</p><h3>{format[0]}</h3><p>{format[1]}</p></article>)}</div></div></section>

    <section class="editorial-section" aria-labelledby="events-title"><div class="shell events-layout"><div><p class="system-label">05 / Selected previous events</p><h2 id="events-title">Speaking grounded in practice.</h2><p>Selected previous appearances are listed as professional context, not as endorsements.</p></div><ul>{events.map((event) => <li>{event}</li>)}</ul></div></section>

    <section class="editorial-section context-section" aria-labelledby="context-title"><div class="shell"><p class="system-label">06 / Context</p><h2 id="context-title">Academic perspective. Professional experience.</h2><div class="context-columns"><div><h3>Academic</h3><p>Guest Lecturer — UCL</p><p>Associate Lecturer — Buckinghamshire New University</p></div><div><h3>Professional background</h3><p>Vodafone / EY / Worldline / Nscale</p></div></div></div></section>

    <section class="editorial-section editorial-paper" aria-labelledby="bio-title"><div class="shell editorial-split"><div><p class="system-label">07 / Speaker biography</p><h2 id="bio-title">Gishan Nissanka</h2></div><div><p>Gishan is a People Technology and AI Transformation leader with experience across workforce intelligence, people data, HR systems, AI adoption and organisational transformation.</p><p>His qualifications include an MBA, an MSc in Business Information Technology, the Oxford AI Programme and the LSE Ethics of AI programme.</p><a class="text-link" href="/about/">Read more about Gishan <span aria-hidden="true">→</span></a><br /><a class="text-link ideas-link" href="/ideas/">Explore the ideas behind the talks <span aria-hidden="true">→</span></a></div></div></section>

    <section class="editorial-final" aria-labelledby="speaking-final-title"><div class="shell editorial-final__grid"><div><p class="system-label">08 / Enquiries</p><h2 id="speaking-final-title">Bring the conversation into the room.</h2></div><div><p class="editorial-final__copy">For conferences, leadership sessions, executive conversations and academic events.</p><a class="cta-inverse" href="mailto:gishan@nissanka.co.uk?subject=Speaking%20enquiry">Enquire about speaking</a><p class="advisory-link"><a href="/advisory/">Explore related advisory work <span aria-hidden="true">→</span></a></p></div></div></section>
</BaseLayout>

<style>
    .speaking-hero{background:var(--colour-obsidian);color:var(--colour-white)}.speaking-hero__grid{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:var(--grid-gap);align-items:center;margin-top:2rem}.speaking-hero figure{grid-column:1/span 7;min-width:0;margin:0;aspect-ratio:5/4;overflow:hidden}.speaking-hero figure :global(img){width:100%;height:100%;object-fit:cover;object-position:center 38%;filter:grayscale(100%)}.speaking-hero__grid>div{grid-column:9/-1}.speaking-hero h1{max-width:10ch;margin:0 0 2rem;font-size:clamp(3.5rem,5vw,4.5rem);letter-spacing:-.05em}.credibility{margin:2rem 0}.hero-cta{display:inline-block;padding:.9rem 1.2rem;background:var(--colour-white);color:var(--colour-black);font-size:.875rem;font-weight:700;text-decoration:none}
    .keynote-layout{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:var(--grid-gap)}.keynote-layout>div:first-child{grid-column:1/span 7}.keynote-layout>div:last-child{grid-column:9/-1;align-self:end}.keynote-layout h2{font-family:var(--font-display);font-size:clamp(3.5rem,6vw,5.5rem);font-weight:900}.keynote-subtitle{max-width:35rem;font-size:1.25rem;font-weight:700}.keynote-layout>div:last-child p{margin:0}.keynote-layout>div:last-child p+p{margin-top:1.25rem}
    .speaking-themes{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(3rem,8vw,8rem);margin-top:5rem}.speaking-themes article{padding-top:1.5rem;border-top:var(--border-architectural)}.speaking-themes h3{font-size:1.5rem;text-transform:uppercase}.format-list{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));margin-top:5rem;border-top:1px solid white}.format-list article{padding:1.5rem;border-left:1px solid white}.format-list article:first-child{border-left:0}.format-list article>p:first-child{font-family:var(--font-mono);font-size:.75rem}.format-list h3{text-transform:uppercase}
    .events-layout{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:var(--grid-gap)}.events-layout>div{grid-column:1/span 6}.events-layout ul{grid-column:8/-1;margin:0;padding:0;list-style:none}.events-layout li{padding:1rem 0;border-top:var(--border-architectural)}.context-columns{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--grid-gap);margin-top:5rem}.context-columns>div{padding-top:1.5rem;border-top:var(--border-architectural)}.context-columns h3{text-transform:uppercase}.context-columns p{margin:.5rem 0}.ideas-link{margin-top:1rem}.advisory-link{margin-top:2rem;font-size:.875rem}
    @media(max-width:52rem){.speaking-hero__grid,.keynote-layout,.events-layout{grid-template-columns:minmax(0,1fr)}.speaking-hero figure,.speaking-hero__grid>div,.keynote-layout>div:first-child,.keynote-layout>div:last-child,.events-layout>div,.events-layout ul{grid-column:1}.speaking-hero__grid>div,.keynote-layout>div:last-child,.events-layout ul{margin-top:3rem}.speaking-hero figure{aspect-ratio:16/10}.format-list{grid-template-columns:repeat(2,minmax(0,1fr))}.format-list article:nth-child(3){border-top:1px solid white;border-left:0}.format-list article:nth-child(4){border-top:1px solid white}}
    @media(max-width:38rem){.speaking-themes,.context-columns,.format-list{grid-template-columns:1fr}.format-list article{border-top:1px solid white;border-left:0}.format-list article:first-child{border-top:0}}
</style>
