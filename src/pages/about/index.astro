---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import "../../styles/editorial-pages.css";

const title = "About Gishan Nissanka | Nissanka Advisory";
const description = "Gishan Nissanka works across AI transformation, workforce intelligence, people technology and organisational decision-making.";
const principles = [
    ["Clarity", "Understand what is actually changing."],
    ["Judgement", "Separate useful AI opportunities from attractive distractions."],
    ["Context", "Design recommendations around the organisation, not around generic maturity models."],
    ["Adoption", "Treat people, behaviour and leadership as part of the solution."],
];
const structuredData = {
    "@context": "https://schema.org",
    "@graph": [
        { "@type": "ProfilePage", "@id": "https://nissanka.co.uk/about/#webpage", url: "https://nissanka.co.uk/about/", name: title, description, mainEntity: { "@id": "https://nissanka.co.uk/#gishan-nissanka" } },
        { "@type": "Person", "@id": "https://nissanka.co.uk/#gishan-nissanka", name: "Gishan Nissanka", jobTitle: "People Technology and AI Transformation leader", url: "https://nissanka.co.uk/about/" },
        { "@type": "BreadcrumbList", itemListElement: [
            { "@type": "ListItem", position: 1, name: "Home", item: "https://nissanka.co.uk/" },
            { "@type": "ListItem", position: 2, name: "About", item: "https://nissanka.co.uk/about/" },
        ] },
    ],
};
---

<BaseLayout {title} {description} path="/about/" {structuredData}>
    <section class="editorial-page-hero about-hero" aria-labelledby="about-title"><div class="shell"><Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "About" }]} /><p class="system-label">01 / About</p><div class="about-hero__grid"><h1 id="about-title">Where people, technology and work meet.</h1><div><p>Gishan Nissanka works at the intersection of AI, workforce intelligence, people technology and organisational transformation.</p><p>His work focuses on helping organisations make better decisions about how technology changes work, skills, leadership and operating models.</p></div></div></div></section>

    <section class="editorial-section editorial-paper" aria-labelledby="reality-title"><div class="shell editorial-split"><div><p class="system-label">02 / Organisational reality</p><h2 id="reality-title" class="display-statement">Technology changes quickly.<br />Organisations do not.</h2></div><div><p class="lead-copy">The interesting work sits between technological possibility and organisational reality.</p><p>That includes decisions, behaviour, skills, data, governance, leadership and how work is organised.</p></div></div></section>

    <section class="editorial-section" aria-labelledby="experience-title"><div class="shell experience-layout"><div><p class="system-label">03 / Professional experience</p><h2 id="experience-title">Experience inside transformation.</h2><p>Work across People Technology, People Analytics, Workforce Intelligence, HR systems, AI adoption and organisational transformation.</p></div><div><p class="experience-note">Professional experience, not a list of Nissanka Advisory clients.</p><ul><li>Vodafone</li><li>EY</li><li>Worldline</li><li>Nscale</li></ul></div></div></section>

    <section class="editorial-section credentials-section" aria-labelledby="credentials-title"><div class="shell"><p class="system-label">04 / Academic + education</p><h2 id="credentials-title">Practice informed by learning and teaching.</h2><div class="credential-columns"><div><h3>Academic</h3><p>Guest Lecturer — UCL</p><p>Associate Lecturer — Buckinghamshire New University</p></div><div><h3>Education</h3><p>MBA</p><p>MSc Business Information Technology</p><p>Oxford AI Programme</p><p>LSE Ethics of AI programme</p></div></div></div></section>

    <section class="editorial-section editorial-dark" aria-labelledby="work-title"><div class="shell"><p class="system-label">05 / How I work</p><h2 id="work-title">Practical before theoretical.</h2><p class="work-intro">The approach is built around understanding the real organisational problem before introducing technology.</p><ol class="principle-list">{principles.map((principle,index)=><li><span>0{index+1}</span><div><h3>{principle[0]}</h3><p>{principle[1]}</p></div></li>)}</ol></div></section>

    <section class="editorial-section" aria-labelledby="connection-title"><div class="shell editorial-split"><div><p class="system-label">06 / Advisory</p><h2 id="connection-title">A connected view of AI, people and work.</h2></div><div><p>This background informs work across AI Strategy & Transformation, Workforce Intelligence and Leadership Readiness.</p><a class="text-link" href="/advisory/">Explore Advisory <span aria-hidden="true">→</span></a></div></div></section>

    <section class="editorial-section editorial-paper speaking-connection" aria-labelledby="speaking-connection-title"><div class="shell"><p class="system-label">07 / Speaking</p><h2 id="speaking-connection-title">Ideas also travel beyond advisory work.</h2><a class="text-link" href="/speaking/">Explore Speaking <span aria-hidden="true">→</span></a><a class="text-link ideas-link" href="/ideas/">Explore Ideas <span aria-hidden="true">→</span></a></div></section>

    <section class="editorial-final" aria-labelledby="about-final-title"><div class="shell editorial-final__grid"><div><p class="system-label">08 / Start</p><h2 id="about-final-title">Start with the question, not the technology.</h2></div><div><p class="editorial-final__copy">Discuss the organisational decision, workforce question or leadership challenge that needs clarity.</p><a class="cta-inverse" href="mailto:gishan@nissanka.co.uk?subject=Advisory%20challenge">Discuss an advisory challenge</a></div></div></section>
</BaseLayout>

<style>
    .about-hero__grid{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:var(--grid-gap);align-items:end;margin-top:2rem}.about-hero h1{grid-column:1/span 7;max-width:11ch;margin:0;font-size:clamp(3.5rem,5vw,4.5rem);letter-spacing:-.05em}.about-hero__grid>div{grid-column:9/-1}.about-hero__grid>div p{margin:0}.about-hero__grid>div p+p{margin-top:1.25rem}.experience-layout{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:var(--grid-gap)}.experience-layout>div:first-child{grid-column:1/span 6}.experience-layout>div:last-child{grid-column:8/-1}.experience-layout ul{margin:2rem 0 0;padding:0;list-style:none}.experience-layout li{padding:1rem 0;border-top:var(--border-architectural);font-size:1.35rem;font-weight:700}.experience-note{font-family:var(--font-mono);font-size:.7rem;text-transform:uppercase}.credential-columns{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(3rem,8vw,8rem);margin-top:5rem}.credential-columns>div{padding-top:1.5rem;border-top:var(--border-architectural)}.credential-columns h3{text-transform:uppercase}.credential-columns p{margin:.5rem 0}.work-intro{max-width:42rem;font-size:1.125rem}.principle-list{margin:5rem 0 0;padding:0;list-style:none}.principle-list li{display:grid;grid-template-columns:4rem 1fr;gap:var(--grid-gap);padding:2rem 0;border-top:1px solid white}.principle-list span{font-family:var(--font-mono);font-size:.75rem}.principle-list h3{margin:0 0 .75rem;text-transform:uppercase}.principle-list p{margin:0}.speaking-connection h2{max-width:20ch}.ideas-link{margin-left:2rem}
    @media(max-width:52rem){.about-hero__grid,.experience-layout{grid-template-columns:minmax(0,1fr)}.about-hero h1,.about-hero__grid>div,.experience-layout>div:first-child,.experience-layout>div:last-child{grid-column:1}.about-hero__grid>div,.experience-layout>div:last-child{margin-top:3rem}}
    @media(max-width:38rem){.credential-columns{grid-template-columns:1fr}.ideas-link{display:block;margin-left:0}.principle-list li{grid-template-columns:2.5rem 1fr}}
</style>
