---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import "../../styles/editorial-pages.css";
import { contactHref } from "../../config/practices";

const title = "About Nissanka Advisory | AI & Workforce Intelligence";
const description = "Nissanka Advisory combines deep capability in AI transformation, workforce intelligence, people technology and organisational change.";
const principles = [
    ["Clarity", "Understand what is actually changing."],
    ["Judgement", "Separate useful AI opportunities from attractive distractions."],
    ["Context", "Design recommendations around the organisation, not around generic maturity models."],
    ["Adoption", "Treat people, behaviour and leadership as part of the solution."],
];
const structuredData = {
    "@context": "https://schema.org",
    "@graph": [
        { "@type": "AboutPage", "@id": "https://nissanka.co.uk/about/#webpage", url: "https://nissanka.co.uk/about/", name: title, description, about: { "@id": "https://nissanka.co.uk/#organisation" } },
        { "@type": "Organization", "@id": "https://nissanka.co.uk/#organisation", name: "Nissanka Advisory", legalName: "Nissanka Group Ltd", url: "https://nissanka.co.uk/", description },
        { "@type": "Person", "@id": "https://nissanka.co.uk/#gishan-nissanka", name: "Gishan Nissanka", jobTitle: "People Technology and AI Transformation leader", url: "https://nissanka.co.uk/about/" },
        { "@type": "Person", "@id": "https://nissanka.co.uk/#kasia-nissanka", name: "Kasia Nissanka", jobTitle: "Executive & Leadership Coach", url: "https://nissanka.co.uk/about/", hasCredential: { "@type": "EducationalOccupationalCredential", name: "ICF Professional Certified Coach (PCC)" } },
        { "@type": "BreadcrumbList", itemListElement: [
            { "@type": "ListItem", position: 1, name: "Home", item: "https://nissanka.co.uk/" },
            { "@type": "ListItem", position: 2, name: "About", item: "https://nissanka.co.uk/about/" },
        ] },
    ],
};
---

<BaseLayout {title} {description} path="/about/" {structuredData}>
    <section class="editorial-page-hero about-hero" aria-labelledby="about-title"><div class="shell"><Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "About" }]} /><p class="system-label">About Nissanka Advisory</p><div class="about-hero__grid"><h1 id="about-title">Where AI, people and work meet.</h1><div><p>Nissanka Advisory combines deep capability in AI transformation, workforce intelligence, people technology and organisational change.</p><p>Leadership development and coaching provide supporting capability where wider change depends on how leaders decide, communicate and act.</p></div></div></div></section>

    <section class="editorial-section editorial-paper" aria-labelledby="reality-title"><div class="shell editorial-split"><div><p class="system-label">Organisational reality</p><h2 id="reality-title" class="display-statement">Technology changes quickly.<br />Organisations do not.</h2></div><div><p class="lead-copy">The interesting work sits between technological possibility and organisational reality.</p><p>That includes decisions, behaviour, skills, data, governance, leadership and how work is organised.</p></div></div></section>

    <section class="editorial-section" aria-labelledby="people-title"><div class="shell"><p class="system-label">Our people</p><h2 id="people-title">Expertise connected around the work.</h2><div class="people-list"><article><h3>Gishan Nissanka</h3><p class="person-focus">AI Transformation / Workforce Intelligence / People Technology &amp; Analytics / Organisational Change</p><p>Gishan’s experience spans people technology, workforce analytics, HR systems, AI adoption and organisational transformation across Vodafone, EY, Worldline and Nscale.</p><p>He is a Guest Lecturer at UCL and an Associate Lecturer at Buckinghamshire New University. His education includes an MBA, MSc Business Information Technology, the Oxford AI Programme and the LSE Ethics of AI programme.</p><a class="text-link" href="/profile/">View Gishan’s professional profile <span aria-hidden="true">→</span></a></article><article><h3>Kasia Nissanka</h3><p class="person-focus">Executive &amp; Leadership Coach / ICF PCC / Coach Supervisor</p><p>Kasia Nissanka is an Executive &amp; Leadership Coach, ICF Professional Certified Coach and Coach Supervisor. She brings psychologically grounded leadership and coaching capability to Nissanka Advisory.</p><p>Her experience includes supporting senior and emerging leaders in NHS Trusts and contributing to leadership and coaching development through the Buckinghamshire Coaching &amp; Mentoring Academy.</p><p>Her approach is calm, clear and deeply human, combining psychological insight with practical experience of complex organisational environments.</p><p class="credentials-line">ICF PCC · Diploma in Coaching Supervision · MSc Occupational Psychology · MSc Educational, Family &amp; Rehabilitation Psychology</p></article></div></div></section>

    <section class="editorial-section credentials-section" aria-labelledby="practices-title"><div class="shell"><p class="system-label">The practice</p><h2 id="practices-title">Core expertise, strengthened where change needs leadership.</h2><div class="credential-columns"><div><h3>AI &amp; Transformation</h3><p>Where AI can create value, what needs stronger foundations and how adoption becomes practical.</p></div><div><h3>Workforce Intelligence</h3><p>How evidence about people, skills, capacity and work supports better organisational decisions.</p></div></div><div class="supporting-capability"><p class="system-label">Supporting capability</p><h3>Leadership Advisory &amp; Development</h3><p>Leadership development and coaching complement wider AI, workforce and organisational-change work, and remain available as focused standalone support where appropriate.</p></div></div></section>

    <section class="editorial-section editorial-dark" aria-labelledby="work-title"><div class="shell"><p class="system-label">How we work</p><h2 id="work-title">Practical before theoretical.</h2><p class="work-intro">The approach begins with the real organisational problem, the decision that needs to be made and the people who need to make it work.</p><div class="principle-list">{principles.map((principle)=><article><h3>{principle[0]}</h3><p>{principle[1]}</p></article>)}</div></div></section>

    <section class="editorial-section" aria-labelledby="connection-title"><div class="shell editorial-split"><div><p class="system-label">What We Do</p><h2 id="connection-title">AI direction grounded in workforce reality.</h2></div><div><p>The core work brings AI &amp; Transformation and Workforce Intelligence together. Leadership capability strengthens engagements when organisational change requires it.</p><a class="text-link" href="/advisory/">Explore What We Do <span aria-hidden="true">→</span></a></div></div></section>

    <section class="editorial-section editorial-paper speaking-connection" aria-labelledby="speaking-connection-title"><div class="shell"><p class="system-label">Speaking</p><h2 id="speaking-connection-title">Ideas also travel beyond advisory work.</h2><a class="text-link" href="/speaking/">Explore Speaking <span aria-hidden="true">→</span></a><a class="text-link ideas-link" href="/ideas/">Explore Ideas <span aria-hidden="true">→</span></a></div></section>

    <section class="editorial-final" aria-labelledby="about-final-title"><div class="shell editorial-final__grid"><div><p class="system-label">Start</p><h2 id="about-final-title">Start with the question that needs clarity.</h2></div><div><p class="editorial-final__copy">Discuss the organisational decision, workforce question or leadership challenge that needs attention.</p><a class="cta-inverse" href={contactHref}>Start a Conversation</a></div></div></section>
</BaseLayout>

<style>
    .about-hero__grid{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:var(--grid-gap);align-items:end;margin-top:2rem}.about-hero h1{grid-column:1/span 7;max-width:11ch;margin:0;font-size:clamp(3.5rem,5vw,4.5rem);letter-spacing:-.05em}.about-hero__grid>div{grid-column:9/-1}.about-hero__grid>div p{margin:0}.about-hero__grid>div p+p{margin-top:1.25rem}.people-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(3rem,8vw,8rem);margin-top:4rem}.people-list article{padding-top:1.5rem;border-top:var(--border-architectural)}.people-list h3{margin:0;font-size:clamp(2rem,3vw,2.75rem)}.person-focus,.credentials-line{font-family:var(--font-mono);font-size:.7rem;text-transform:uppercase}.credential-columns{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(2rem,5vw,5rem);margin-top:5rem}.credential-columns>div,.supporting-capability{padding-top:1.5rem;border-top:var(--border-architectural)}.credential-columns h3,.supporting-capability h3{text-transform:uppercase}.credential-columns p{margin:.5rem 0}.supporting-capability{max-width:46rem;margin-top:4rem}.supporting-capability h3{margin:1.25rem 0 .75rem}.work-intro{max-width:42rem;font-size:1.125rem}.principle-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 var(--grid-gap);margin:5rem 0 0}.principle-list article{padding:2rem 0;border-top:1px solid white}.principle-list h3{margin:0 0 .75rem;text-transform:uppercase}.principle-list p{margin:0}.speaking-connection h2{max-width:20ch}.ideas-link{margin-left:2rem}
    @media(max-width:52rem){.about-hero__grid,.experience-layout{grid-template-columns:minmax(0,1fr)}.about-hero h1,.about-hero__grid>div,.experience-layout>div:first-child,.experience-layout>div:last-child{grid-column:1}.about-hero__grid>div,.experience-layout>div:last-child{margin-top:3rem}}
    @media(max-width:52rem){.people-list,.credential-columns{grid-template-columns:1fr}}
    @media(max-width:38rem){.ideas-link{display:block;margin-left:0}.principle-list{grid-template-columns:1fr}}
</style>
