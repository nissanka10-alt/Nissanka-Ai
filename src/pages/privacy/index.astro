---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";

const title = "Privacy & Cookie Policy | Nissanka Advisory";
const description = "How Nissanka Advisory collects, uses and protects personal information, including contact-form data and necessary website cookies.";
const structuredData = {
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "WebPage",
            "@id": "https://nissanka.co.uk/privacy/#webpage",
            url: "https://nissanka.co.uk/privacy/",
            name: title,
            description,
        },
        {
            "@type": "BreadcrumbList",
            itemListElement: [
                { "@type": "ListItem", position: 1, name: "Home", item: "https://nissanka.co.uk/" },
                { "@type": "ListItem", position: 2, name: "Privacy & Cookie Policy", item: "https://nissanka.co.uk/privacy/" },
            ],
        },
    ],
};
---

<BaseLayout {title} {description} path="/privacy/" {structuredData}>
    <header class="privacy-header">
        <div class="shell privacy-shell">
            <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Privacy & Cookie Policy" }]} />
            <p class="system-label">Legal</p>
            <h1>Privacy &amp; Cookie Policy</h1>
            <p class="policy-date">Last updated: July 2026</p>
        </div>
    </header>

    <div class="shell privacy-shell policy-content">
        <section aria-labelledby="who-we-are">
            <h2 id="who-we-are">1. Who We Are</h2>
            <p>Nissanka Group Ltd, trading as Nissanka Advisory ("we", "our", or "us"), operates the website <a href="https://nissanka.co.uk/">https://nissanka.co.uk</a>. We are committed to protecting your privacy and handling your personal data in an open, transparent, and compliant manner in accordance with UK Data Protection law (UK GDPR and the Data Protection Act 2018).</p>
            <p>Nissanka Group Ltd is a private limited company incorporated in England and Wales. Company No. 17486709.</p>
            <address>
                <strong>Registered office</strong><br />
                Kings Head House<br />
                15 London End<br />
                Beaconsfield<br />
                HP9 2HN<br />
                Buckinghamshire<br />
                United Kingdom
            </address>
        </section>

        <section aria-labelledby="information-we-collect">
            <h2 id="information-we-collect">2. Information We Collect</h2>
            <p>We collect personal information that you voluntarily provide to us when you fill out our discovery call contact form. This includes:</p>
            <ul>
                <li>Full Name</li>
                <li>Work Email Address</li>
                <li>Organisation Name</li>
                <li>Any project details or messages submitted in the contact form</li>
            </ul>
        </section>

        <section aria-labelledby="how-we-use-information">
            <h2 id="how-we-use-information">3. How We Use Your Information</h2>
            <p>We use the information you submit solely to:</p>
            <ul>
                <li>Respond to your enquiries and requests for discovery calls.</li>
                <li>Discuss and arrange potential advisory services.</li>
            </ul>
            <p>We will never sell, rent, or trade your personal information with third parties for marketing purposes.</p>
        </section>

        <section aria-labelledby="how-data-is-processed">
            <h2 id="how-data-is-processed">4. How Your Data Is Processed</h2>
            <p>Contact form inquiries are processed via FormSubmit and securely routed to our email inbox (<a href="mailto:gishan@nissanka.co.uk">gishan@nissanka.co.uk</a>). We maintain appropriate technical and organisational security measures to protect your data against unauthorised access or loss.</p>
        </section>

        <section aria-labelledby="cookies-and-tracking">
            <h2 id="cookies-and-tracking">5. Cookies &amp; Tracking</h2>
            <p>Our website uses <strong>strictly necessary operational cookies</strong> provided by our hosting platform (Cloudflare) to ensure site security, perform load balancing, and protect against malicious traffic.</p>
            <p>We do <strong>not</strong> use non-essential advertising pixels, behavioural tracking, or third-party analytics cookies. As a result, no opt-in cookie banner is required when visiting this site.</p>
        </section>

        <section aria-labelledby="your-rights">
            <h2 id="your-rights">6. Your Rights</h2>
            <p>Under UK GDPR, you have the right to:</p>
            <ul>
                <li>Request access to the personal data we hold about you.</li>
                <li>Request the correction or deletion of your personal data.</li>
                <li>Withdraw consent at any time where processing is based on consent.</li>
            </ul>
        </section>

        <section aria-labelledby="contact-us">
            <h2 id="contact-us">7. Contact Us</h2>
            <p>If you have any questions about this Privacy Policy or wish to exercise your data rights, please contact us at:</p>
            <p><strong>Email:</strong> <a href="mailto:gishan@nissanka.co.uk">gishan@nissanka.co.uk</a></p>
        </section>
    </div>
</BaseLayout>

<style>
    .privacy-header {
        padding-block: 2rem clamp(4rem, 8vw, 7rem);
        border-bottom: var(--border-architectural);
        background: var(--colour-paper);
    }

    .privacy-shell {
        max-width: 52rem;
    }

    .privacy-header :global(.breadcrumbs) {
        margin-bottom: clamp(3rem, 7vw, 6rem);
    }

    .privacy-header h1 {
        max-width: 15ch;
        margin: 1.5rem 0 1rem;
        font-size: clamp(3rem, 6vw, 4.75rem);
        letter-spacing: -0.035em;
        line-height: 1;
    }

    .policy-date {
        margin: 0;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        text-transform: uppercase;
    }

    .policy-content {
        padding-block: clamp(4rem, 8vw, 7rem);
    }

    .policy-content section + section {
        margin-top: clamp(3rem, 6vw, 5rem);
        padding-top: clamp(3rem, 6vw, 5rem);
        border-top: var(--border-architectural);
    }

    .policy-content h2 {
        margin: 0 0 1.5rem;
        font-size: clamp(1.5rem, 3vw, 2.1rem);
        letter-spacing: -0.025em;
        line-height: 1.15;
    }

    .policy-content p,
    .policy-content address,
    .policy-content li {
        line-height: 1.75;
    }

    .policy-content p,
    .policy-content address {
        margin: 1rem 0 0;
    }

    .policy-content ul {
        margin: 1rem 0 0;
        padding-left: 1.4rem;
    }

    .policy-content li + li {
        margin-top: 0.5rem;
    }

    .policy-content address {
        font-style: normal;
    }

    .policy-content a {
        overflow-wrap: anywhere;
        text-underline-offset: 0.3em;
    }
</style>
