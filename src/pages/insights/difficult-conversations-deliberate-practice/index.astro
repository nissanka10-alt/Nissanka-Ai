---
import ArticleBody from "../../../content/insights/difficult-conversations-deliberate-practice.md";
import ArticleUtilities from "../../../components/ArticleUtilities.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { gishanEntity, organisationEntity } from "../../../config/entities";
import { formatInsightDate, insights } from "../../../data/insights";

const insight = insights.find((item) => item.slug === "difficult-conversations-deliberate-practice")!;
const title = "Difficult Conversations: Why Leaders Need Practice, Not Just Experience | Nissanka Advisory";
const description = insight.summary;
const path = `/insights/${insight.slug}/`;
const url = new URL(path, Astro.site).href;
const structuredData = {
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "BlogPosting",
            "@id": `${url}#article`,
            headline: insight.title,
            alternativeHeadline: insight.subtitle,
            description,
            url,
            datePublished: insight.published,
            author: gishanEntity,
            publisher: organisationEntity,
            mainEntityOfPage: { "@type": "WebPage", "@id": url },
        },
        {
            "@type": "BreadcrumbList",
            itemListElement: [
                { "@type": "ListItem", position: 1, name: "Home", item: new URL("/", url).href },
                { "@type": "ListItem", position: 2, name: "Insights", item: new URL("/insights/", url).href },
                { "@type": "ListItem", position: 3, name: insight.title, item: url },
            ],
        },
    ],
};
---

<BaseLayout {title} {description} {path} type="article" {structuredData}>
    <article>
        <header class="hero">
            <div class="shell">
                <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Insights", href: "/insights/" }, { label: insight.title }]} />
                <p class="system-label">Leadership Readiness · AI &amp; Human Capability · 2026</p>
                <div class="hero-grid">
                    <h1>{insight.title}</h1>
                    <p class="subtitle"><em>{insight.subtitle}</em></p>
                </div>
                <dl class="meta">
                    <div><dt>Author</dt><dd><a href="/profile/" rel="author">{insight.author}</a></dd></div>
                    <div><dt>Published</dt><dd><time datetime={insight.published}>{formatInsightDate(insight.published)}</time></dd></div>
                    <div><dt>Topic</dt><dd>{insight.topic}</dd></div>
                    <div><dt>Geography</dt><dd>{insight.geography}</dd></div>
                    <div><dt>Format</dt><dd>{insight.format}</dd></div>
                </dl>
                <ArticleUtilities title={insight.title} url={path} />
            </div>
        </header>

        <div class="prose">
            <ArticleBody />
        </div>
    </article>
</BaseLayout>

<style>
    .hero {
        padding-block: 2rem clamp(4.5rem, 9vw, 8rem);
        border-bottom: var(--border-architectural);
        background: var(--colour-paper);
    }

    .hero :global(.breadcrumbs) {
        margin-bottom: clamp(3rem, 7vw, 6rem);
    }

    .hero-grid {
        display: grid;
        grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
        align-items: end;
        gap: var(--grid-gap);
        margin-top: 1.5rem;
    }

    .hero h1,
    .subtitle,
    .prose :global(h2) {
        font-family: var(--font-display);
        font-weight: 900;
        font-feature-settings: "kern" 1;
        font-kerning: normal;
        letter-spacing: normal;
    }

    .hero h1 {
        max-width: 17ch;
        margin: 0;
        font-size: clamp(2.75rem, 5.6vw, 5.5rem);
        line-height: .98;
    }

    .subtitle {
        max-width: 23ch;
        margin: 0;
        font-size: clamp(1.65rem, 3.2vw, 2.75rem);
        line-height: 1.1;
    }

    .meta {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 1rem;
        margin: clamp(2.5rem, 5vw, 4rem) 0 1rem;
        padding-block: 1.25rem;
        border-top: var(--border-architectural);
    }

    .meta dt {
        font-family: var(--font-mono);
        font-size: .8125rem;
        text-transform: uppercase;
    }

    .meta dd {
        margin: .5rem 0 0;
        font-size: .9375rem;
    }

    .prose {
        width: min(calc(100% - 3rem), 44rem);
        margin-inline: auto;
        padding-block: clamp(4rem, 8vw, 8rem);
        font-size: 1.0625rem;
        line-height: 1.75;
    }

    .prose :global(h2) {
        margin: clamp(3.5rem, 7vw, 6rem) 0 1.5rem;
        font-size: clamp(2rem, 4.5vw, 3.75rem);
        line-height: 1.05;
    }

    .prose :global(p) { margin: 1.25rem 0; }
    .prose :global(> p:first-child) {
        margin-top: 0;
        font-size: 1.375rem;
        font-weight: 700;
    }

    .prose :global(ul) { padding-inline-start: 1.5rem; }
    .prose :global(li + li) { margin-top: 1rem; }
    .prose :global(a), .meta a { text-underline-offset: .25em; }

    @media (max-width: 52rem) {
        .hero-grid { grid-template-columns: minmax(0, 1fr); }
        .meta { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }

    @media (max-width: 30rem) {
        .hero h1 { font-size: clamp(2rem, 10vw, 2.75rem); }
    }

    @media print {
        :global(.site-header),
        :global(.site-footer),
        .hero :global(.breadcrumbs),
        .hero :global(.article-utilities) { display: none !important; }

        .hero { padding-block: 0 1rem; background: white; }
        .hero-grid { display: block; }
        .prose { width: 100%; padding-block: 1rem; }
        .prose :global(h2) { break-after: avoid; }
    }
</style>
