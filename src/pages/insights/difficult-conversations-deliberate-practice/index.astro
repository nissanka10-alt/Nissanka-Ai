---
import InsightArticle from "../../../components/insights/InsightArticle.astro";
import InsightAuthor from "../../../components/insights/InsightAuthor.astro";
import ArticleBody from "../../../content/insights/difficult-conversations-deliberate-practice.md";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { gishanEntity, organisationEntity } from "../../../config/entities";
import { insights } from "../../../data/insights";

const insight = insights.find((item) => item.slug === "difficult-conversations-deliberate-practice")!;
const title = "Difficult Conversations: Why Leaders Need Practice, Not Just Experience | Nissanka Advisory";
const description = insight.summary;
const path = `/insights/${insight.slug}/`;
const url = new URL(path, Astro.site).href;
const structuredData = {
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "BlogPosting",
            "@id": `${url}#article`,
            headline: insight.title,
            alternativeHeadline: insight.subtitle,
            description,
            url,
            datePublished: insight.published,
            author: gishanEntity,
            publisher: organisationEntity,
            mainEntityOfPage: { "@type": "WebPage", "@id": url },
        },
        {
            "@type": "BreadcrumbList",
            itemListElement: [
                { "@type": "ListItem", position: 1, name: "Home", item: new URL("/", url).href },
                { "@type": "ListItem", position: 2, name: "Insights", item: new URL("/insights/", url).href },
                { "@type": "ListItem", position: 3, name: insight.title, item: url },
            ],
        },
    ],
};
---

<BaseLayout {title} {description} {path} type="article" {structuredData}>
    <InsightArticle
        {insight}
        {path}
        eyebrow={"Leadership Readiness · AI & Human Capability · 2026"}
        openingTreatment="plain"
        standfirst={insight.subtitle}
    >
        <div class="nk-reading nk-prose nk-dropcap">
            <ArticleBody />
        </div>

        <Fragment slot="closing">
            <InsightAuthor headingId="author-title" />
            {insight.advisoryPath && (
                <nav class="nk-inverted nk-cta nk-print-hide" aria-label="Where this leads">
                    <div class="shell">
                        <p class="system-label">Where this leads</p>
                        <a href={insight.advisoryPath.href}>{insight.advisoryPath.label}</a>
                    </div>
                </nav>
            )}
        </Fragment>
    </InsightArticle>
</BaseLayout>
