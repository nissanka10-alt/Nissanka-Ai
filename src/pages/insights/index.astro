---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import InsightPrintMasthead from "../../components/insights/InsightPrintMasthead.astro";
import "../../styles/insights.css";
import { featuredInsight, formatInsightDate, insightGeographies, insights, insightTopics } from "../../data/insights";

const libraryInsights = insights
    .filter((insight) => insight.slug !== featuredInsight.slug)
    .sort((a, b) => Date.parse(`${b.published}T00:00:00Z`) - Date.parse(`${a.published}T00:00:00Z`));

const title = "Insights | Nissanka Advisory";
const description = "Research, frameworks and practical perspectives on AI adoption, workforce intelligence, leadership, governance and the future of work.";
const structuredData = {
    "@context": "https://schema.org",
    "@graph": [
        { "@type": "CollectionPage", "@id": "https://nissanka.co.uk/insights/#webpage", url: "https://nissanka.co.uk/insights/", name: title, description },
        { "@type": "BreadcrumbList", itemListElement: [
            { "@type": "ListItem", position: 1, name: "Home", item: "https://nissanka.co.uk/" },
            { "@type": "ListItem", position: 2, name: "Insights", item: "https://nissanka.co.uk/insights/" },
        ] },
    ],
};
---

<BaseLayout {title} {description} path="/insights/" {structuredData}>
    <div class="nk-insights nk-index">
    <InsightPrintMasthead />
    <section class="nk-index-hero" aria-labelledby="insights-title"><div class="shell"><div class="nk-breadcrumb"><Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Insights" }]} /></div><div class="nk-hero"><p class="nk-eyebrow">Insights</p><div class="nk-hero-split"><h1 id="insights-title">Ideas become useful when they change a decision.</h1><p class="nk-standfirst">Research, frameworks and practical perspectives for leaders navigating AI, workforce change and organisational transformation.</p></div></div></div></section>

    <section class="discovery" aria-labelledby="discovery-title"><div class="shell"><p class="system-label">Discover</p><h2 id="discovery-title">A growing library organised for useful discovery.</h2><div class="taxonomy"><nav aria-label="Insight topics"><p>Topic</p><ul>{insightTopics.map((topic) => <li><a href="#published-insights">{topic}</a></li>)}</ul></nav><div aria-label="Available geography metadata"><p>Geography</p><ul><li><span>All</span></li>{insightGeographies.map((geography) => <li><span>{geography}</span></li>)}</ul></div></div><p class="taxonomy-note">Topic and geography labels are publishing metadata. Dedicated filters will be introduced when the library contains enough material to make them useful.</p><aside class="regional-focus" aria-labelledby="regional-focus-title"><p class="system-label" id="regional-focus-title">Regional focus</p><div class="regional-link"><div><h3>Sri Lanka</h3><p>AI, data protection, workforce intelligence and organisational change.</p></div><a href="/sri-lanka/">Explore Sri Lanka <span aria-hidden="true">→</span></a></div><div class="regional-link"><div><h3>Buckinghamshire</h3><p>Practical AI, workforce and leadership support for SMEs and growing businesses.</p></div><a href="/buckinghamshire/">Explore Buckinghamshire <span aria-hidden="true">→</span></a></div></aside></div></section>

    <section id="published-insights" class="featured" aria-labelledby="featured-title"><div class="shell"><p class="system-label">Featured insight</p><article class="featured-grid"><div class="featured-meta"><p>{featuredInsight.format}</p><p>{featuredInsight.topic}</p><p>{featuredInsight.geography}</p>{featuredInsight.readTime && <p>{featuredInsight.readTime}</p>}<p>Published {formatInsightDate(featuredInsight.published)}</p>{featuredInsight.updated && <p>Updated {formatInsightDate(featuredInsight.updated)}</p>}</div><div><h2 id="featured-title">{featuredInsight.title}</h2><p>{featuredInsight.summary}</p><p class="author">By <a href="/profile/">{featuredInsight.author}</a></p><a class="text-link" href={`/insights/${featuredInsight.slug}/`}>Read the full insight <span aria-hidden="true">→</span></a></div></article></div></section>

    {libraryInsights.length > 0 && <section class="published-library" aria-labelledby="library-title"><div class="shell"><p class="system-label">Published insights</p><h2 id="library-title">Research and practical guidance.</h2><div class="library-list">{libraryInsights.map((insight) => <article><div class="library-meta"><span>{insight.topic}</span><span>{insight.geography}</span><span>{insight.format}</span></div><div><h3 class="nk-card-title"><a href={`/insights/${insight.slug}/`}>{insight.displayTitle ?? insight.title}</a></h3>{insight.subtitle && <p class="library-subtitle">{insight.subtitle}</p>}<p>{insight.summary}</p><p class="library-date">Published {formatInsightDate(insight.published)}</p></div></article>)}</div></div></section>}

    <section class="library-note"><div class="shell"><p class="system-label">The library</p><p class="library-statement">The library will grow through published work, not placeholders.</p><p>Future articles, research notes, frameworks and guides will appear here when they are ready.</p><a href="/ideas/">Explore the broader Ideas platform <span aria-hidden="true">→</span></a></div></section>
    </div>
</BaseLayout>

<style>
    .nk-index-hero {
        padding-bottom: clamp(3rem, 6vw, 5.5rem);
    }

    .discovery,
    .featured,
    .published-library,
    .library-note {
        padding-block: clamp(3.5rem, 6vw, 6rem);
        border-bottom: 1px solid var(--nk-rule-strong);
    }

    .discovery h2,
    .published-library h2 {
        max-width: 22ch;
        margin-top: 1rem;
    }

    .taxonomy {
        display: grid;
        grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
        gap: var(--grid-gap);
        margin-top: 2.5rem;
    }

    .taxonomy p,
    .featured-meta p,
    .library-meta,
    .library-date {
        margin: 0;
        color: var(--nk-muted);
        font: 400 .75rem / 1.45 var(--font-mono);
        letter-spacing: .08em;
        text-transform: uppercase;
    }

    .taxonomy ul {
        display: flex;
        flex-wrap: wrap;
        gap: .65rem 1.25rem;
        margin: .85rem 0 0;
        padding: .85rem 0 0;
        border-top: 1px solid var(--nk-rule-subtle);
        list-style: none;
        font-size: .9375rem;
    }

    .taxonomy-note {
        max-width: 45rem;
        margin: 1.5rem 0 0;
        color: var(--nk-muted);
        font-size: .875rem;
    }

    .regional-focus {
        display: grid;
        grid-template-columns: minmax(0, 2fr) minmax(0, 10fr);
        column-gap: var(--grid-gap);
        margin-top: 2.75rem;
        padding-top: 1.25rem;
        border-top: 1px solid var(--nk-rule-strong);
    }

    .regional-link {
        grid-column: 2;
        display: grid;
        grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
        align-items: end;
        gap: var(--grid-gap);
        padding-block: 1.1rem;
        border-bottom: 1px solid var(--nk-rule-subtle);
    }

    .nk-index .regional-link h3 {
        margin: 0 0 .5rem;
    }

    .regional-link p {
        margin: 0;
    }

    .regional-link > a {
        justify-self: end;
        font-weight: 600;
    }

    .featured-grid {
        display: grid;
        grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
        gap: var(--grid-gap);
        margin-top: 1.25rem;
    }

    .featured-meta p {
        padding: .6rem 0;
        border-top: 1px solid var(--nk-rule-subtle);
    }

    .nk-index .featured h2 {
        max-width: 25ch;
        font-size: clamp(2.1rem, 4vw, 3.5rem);
        font-weight: 600;
        line-height: 1.08;
        text-wrap: balance;
    }

    .featured-grid > div:last-child > p,
    .library-list article p {
        max-width: 45rem;
    }

    .author {
        font-size: .875rem;
    }

    .text-link,
    .library-note a {
        display: inline-block;
        margin-top: .75rem;
        font-weight: 600;
    }

    .published-library {
        background: var(--nk-bone);
    }

    .library-list {
        margin-top: clamp(2.5rem, 5vw, 4.5rem);
    }

    .library-list article {
        display: grid;
        grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
        gap: var(--grid-gap);
        padding-block: clamp(1.5rem, 3vw, 2.5rem);
        border-top: 1px solid var(--nk-rule-subtle);
    }

    .library-meta {
        display: flex;
        flex-direction: column;
        gap: .45rem;
    }

    .nk-card-title {
        margin: 0;
        font-size: clamp(1.75rem, 3vw, 2.65rem);
        line-height: 1.14;
    }

    .nk-card-title a {
        text-decoration-thickness: 1px;
        text-underline-offset: .15em;
    }

    .library-subtitle {
        font-weight: 600;
    }

    .library-note .shell {
        max-width: 45rem;
    }

    .library-statement {
        margin: 1.25rem 0;
        font-size: clamp(2rem, 3.5vw, 3rem);
        line-height: 1.14;
    }

    @media (max-width: 52rem) {
        .taxonomy,
        .regional-focus,
        .featured-grid,
        .library-list article {
            grid-template-columns: minmax(0, 1fr);
        }

        .regional-link {
            grid-column: 1;
        }

        .library-meta {
            flex-direction: row;
            flex-wrap: wrap;
            gap: .5rem 1rem;
        }
    }

    @media (max-width: 38rem) {
        .regional-link {
            grid-template-columns: minmax(0, 1fr);
            gap: .75rem;
        }

        .regional-link > a {
            justify-self: start;
        }
    }
</style>
