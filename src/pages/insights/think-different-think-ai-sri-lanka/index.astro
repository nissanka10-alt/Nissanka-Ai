ework,.closing,.pathways{background:var(--colour-obsidian);color:var(--colour-white)}.proposition h2,.ownership h2,.framework h2,.closing h2{max-width:16ch;margin:2rem 0 0;font-size:clamp(3.25rem,6vw,5.75rem);line-height:.96}.proposition-copy,.ownership-copy,.closing-copy{margin-top:clamp(3rem,7vw,6rem)}.framework-intro{max-width:48rem;margin-top:3rem}.framework-list{margin:clamp(4rem,8vw,7rem) 0 0;padding:0;list-style:none;border-top:1px solid #555}.framework-list li{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:var(--grid-gap);padding-block:clamp(2rem,5vw,4rem);border-bottom:1px solid #555}.step-number{grid-column:1/span 2}.framework-list li>div{grid-column:4/span 7}.framework-list h3{margin:0 0 1rem;font-size:clamp(1.75rem,3vw,2.75rem);line-height:1.05}.framework-list p{max-width:42rem;margin:0;font-size:1.0625rem;line-height:1.7}.framework-list p+p{margin-top:1rem}.governance-note{margin-top:clamp(4rem,8vw,7rem)}.human-edge{background:var(--colour-paper)}.final-line{margin-top:3rem!important;font-family:var(--font-display);font-size:clamp(2.75rem,5vw,4.5rem);line-height:1}.references h2,.author-note h2{margin:1.5rem 0 0;font-size:clamp(2.5rem,4vw,3.5rem)}.references ol{margin-top:2.5rem;padding-left:1.4rem}.references li+li{margin-top:1rem}.pathways{border-bottom:0}.pathways .shell{display:flex;flex-wrap:wrap;gap:1.5rem 3rem;align-items:center}.pathways a{font-weight:700}.sr-only{position:absolute;width:1px;height:1px;margin:-1px;overflow:hidden;clip:rect(0,0,0,0)}
