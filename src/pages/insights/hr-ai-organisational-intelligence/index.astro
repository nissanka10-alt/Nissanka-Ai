---
import InsightArticle from "../../../components/insights/InsightArticle.astro";
import InsightAuthor from "../../../components/insights/InsightAuthor.astro";
import InsightReferences from "../../../components/insights/InsightReferences.astro";
import ArticleBody from "../../../content/insights/hr-ai-organisational-intelligence.md";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { gishanEntity, organisationEntity } from "../../../config/entities";
import { insights } from "../../../data/insights";

const insight = insights.find((item) => item.slug === "hr-ai-organisational-intelligence")!;
const title = "AI in HR: Why Hard Data and Soft Content Must Connect | Nissanka Advisory";
const description = "HR AI works when employee data and organisational knowledge connect. A practical look at data foundations, governed content, RAG and workforce intelligence.";
const path = "/insights/hr-ai-organisational-intelligence/";
const url = `https://nissanka.co.uk${path}`;
const structuredData = {
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "BlogPosting",
            "@id": `${url}#article`,
            headline: insight.title,
            description,
            url,
            datePublished: insight.published,
            author: gishanEntity,
            publisher: organisationEntity,
            about: ["AI in HR", "Organisational intelligence", "Workforce intelligence"],
            mainEntityOfPage: { "@type": "WebPage", "@id": url },
        },
        {
            "@type": "BreadcrumbList",
            itemListElement: [
                { "@type": "ListItem", position: 1, name: "Home", item: "https://nissanka.co.uk/" },
                { "@type": "ListItem", position: 2, name: "Insights", item: "https://nissanka.co.uk/insights/" },
                { "@type": "ListItem", position: 3, name: insight.title, item: url },
            ],
        },
    ],
};
---

<BaseLayout {title} {description} {path} type="article" robots="index, follow, max-image-preview:large" {structuredData}>
    <InsightArticle {insight} {path} eyebrow={"AI & Workforce Intelligence · 2026"}>
        <div class="nk-reading nk-prose nk-dropcap">
            <ArticleBody />
        </div>

        <InsightReferences references={insight.references} heading={"Sources & further reading"} headingId="sources-title" />

        <InsightAuthor headingId="author-title" />

        <nav class="pathways nk-print-hide" aria-label="Related pathways">
            <div class="shell">
                <p class="system-label">Continue exploring</p>
                <a href="/advisory/workforce-intelligence/">Workforce Intelligence <span aria-hidden="true">→</span></a>
                <a href="/advisory/ai-strategy/">AI &amp; Transformation <span aria-hidden="true">→</span></a>
                <a href="/ai-review/">AI Opportunity &amp; Readiness Review <span aria-hidden="true">→</span></a>
            </div>
        </nav>
    </InsightArticle>
</BaseLayout>
