---
import InsightArticle from "../../../components/insights/InsightArticle.astro";
import InsightAuthor from "../../../components/insights/InsightAuthor.astro";
import InsightReferences from "../../../components/insights/InsightReferences.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { insights } from "../../../data/insights";
import { gishanEntity, organisationEntity } from "../../../config/entities";
import legacyArticle from "../../../../insights/safe-ai-at-work/index.html?raw";

const insight = insights.find((item) => item.slug === "safe-ai-at-work")!;
const title = "Using AI Safely at Work | Nissanka Advisory";
const description = insight.summary;
const extracted = legacyArticle.match(/<!-- Introduction -->([\s\S]*?)<!-- Conclusion & CTA -->/)?.[1] ?? "";
const articleBody = extracted.replace(/<!--([\s\S]*?)-->/g, "").replace(/\sclass="[^"]*"/g, "")
    .replace("<div>", '<div class="nk-dropcap">')
    .replace(/<div>(\s*<h2>In this guide<\/h2>)/, '<div class="nk-toc" role="navigation" aria-label="In this guide">$1');
const structuredData = {
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "Article",
            "@id": "https://nissanka.co.uk/insights/safe-ai-at-work/#article",
            headline: insight.title,
            description,
            url: "https://nissanka.co.uk/insights/safe-ai-at-work/",
            datePublished: insight.published,
            dateModified: insight.updated,
            author: gishanEntity,
            publisher: organisationEntity,
            about: [insight.topic, insight.geography],
        },
        {
            "@type": "BreadcrumbList",
            itemListElement: [
                { "@type": "ListItem", position: 1, name: "Home", item: "https://nissanka.co.uk/" },
                { "@type": "ListItem", position: 2, name: "Insights", item: "https://nissanka.co.uk/insights/" },
                { "@type": "ListItem", position: 3, name: insight.title, item: "https://nissanka.co.uk/insights/safe-ai-at-work/" },
            ],
        },
    ],
};
---

<BaseLayout {title} {description} path="/insights/safe-ai-at-work/" type="article" {structuredData}>
    <InsightArticle {insight} path="/insights/safe-ai-at-work/" breadcrumbTitle="Safe AI at Work" authorDetail="AI Transformation and Workforce Intelligence leader.">
        <div class="nk-reading nk-prose nk-guide-body" set:html={articleBody}></div>

        <InsightReferences references={insight.references} heading={"Sources & References"} headingId="references-title" />

        <InsightAuthor headingId="author-title" />

        <section class="article-path nk-print-hide" aria-labelledby="path-title"><div class="shell path-grid"><div><p class="system-label">Where this leads</p><h2 id="path-title">Turn safe-use questions into practical organisational decisions.</h2></div><div><p>Explore the connected advisory work or start with a structured review of opportunity, readiness and priorities.</p>{insight.advisoryPath && <a href={insight.advisoryPath.href}>{insight.advisoryPath.label} <span aria-hidden="true">→</span></a>}<a href="/ai-review/">Explore the AI Opportunity & Readiness Review <span aria-hidden="true">→</span></a></div></div></section>
    </InsightArticle>
</BaseLayout>
