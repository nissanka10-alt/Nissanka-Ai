{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "nissankaai",
    "compatibility_date": "2026-10-01",
    "main": "./worker/index.js",
    "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "run_worker_first": [
            "/api/*"
        ]
    },
    "d1_databases": [
        {
            "binding": "LEADS_DB",
            "database_name": "nissanka-leads",
            "migrations_dir": "./migrations"
        }
    ],
    "previews": {}
}
