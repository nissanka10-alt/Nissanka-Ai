{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "nissankaai",
    "compatibility_date": "2026-10-01",
    "main": "./worker/index.js",
    "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "run_worker_first": [
            "/api/*"
        ]
    },
    "d1_databases": [
        {
            "binding": "LEADS_DB",
            "database_name": "nissanka-advisory-leads",
            "database_id": "d97dc6b7-85e7-436e-96b0-19a26114a29f",
            "migrations_dir": "./migrations"
        }
    ],
    "send_email": [
        {
            "name": "EMAIL",
            "allowed_sender_addresses": [
                "gishan@nissanka.co.uk"
            ]
        }
    ],
    "previews": {}
}
